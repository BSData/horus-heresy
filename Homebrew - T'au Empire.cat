<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="ce7b-7026-eda3-920e" name="Homebrew - T'au Empire" revision="1" battleScribeVersion="2.03" library="false" gameSystemId="28d4-bd2e-4858-ece6" gameSystemRevision="130" type="catalogue" authorName="Isaac">
  <publications>
    <publication id="733a-d454-80f2-c90e" name="T'au Empire for The Horus Heresy 2.0 — Homebrew Conversion" shortName="HB - T'au Empire" />
  </publications>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="T'au Empire" hidden="false" id="9fe0-c647-0c8b-a0ec" publicationId="733a-d454-80f2-c90e">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="252e-df85-dea5-fd31" percentValue="false" includeChildSelections="true" includeChildForces="false" />
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="bbba-ad59-df49-cb3d" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Supporting Fire" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="f193-46ac-ccf9-121c">
          <characteristics>
            <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a T'au unit. Up to one other friendly T'au unit (not Auxiliaries) within 6" of the charged unit fires Overwatch at the charging unit, as well as the charged unit†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="e90d-e5a8-f42d-da84" id="004a-f82f-4bf0-eb42" primary="true" name="Allegiance:" />
        <categoryLink targetId="3c8e-5a1d-9b47-e2f0" id="0f76-e6fd-ef03-3183" primary="false" name="Xenos Army" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Sept" hidden="false" id="0e9b-a3be-cf82-6ceb">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e470-2a92-2af6-3fa7" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1683-89fa-2503-4357" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Bork'an" hidden="false" id="d7f9-fabb-7ea9-16dd" publicationId="733a-d454-80f2-c90e">
              <profiles>
                <profile name="Prototype Shields" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="e154-6152-1536-7899">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Bork'an battlesuit or vehicle is selected as the target of a Shooting Attack. Against that attack, the unit gains a 5+ Invulnerable Save.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Sensor Specialists" id="dabc-512e-7c43-23b8" hidden="false">
                  <description>markerlights add one extra Markerlight token for each hit.</description>
                </rule>
                <rule name="Superior Craftsmanship" id="55d0-ddc7-0efd-f5d0" hidden="false">
                  <description>add 6" to the range of Heavy weapons on battlesuits and vehicles.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dal'yth" hidden="false" id="1584-56ec-4e92-6834" publicationId="733a-d454-80f2-c90e">
              <profiles>
                <profile name="Fall Back and Fire" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="2b57-092e-5392-ea54">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Dal'yth unit. Instead of firing Overwatch, the unit moves up to D6 plus its Initiative Characteristic in inches directly away from the charging unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Adaptive Camouflage" id="eb8a-ab0c-93be-71d9" hidden="false">
                  <description>the unit has Shrouded (6+) in a turn in which it did not move.</description>
                </rule>
                <rule name="Hold the Line" id="1b19-ec31-dd76-1d07" hidden="false">
                  <description>Infantry may re-roll failed Morale checks while in cover.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Farsight Enclaves" hidden="false" id="191a-9933-373a-bd05" publicationId="733a-d454-80f2-c90e">
              <profiles>
                <profile name="Hammer Strike" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="52a8-f5a2-abe1-fc02">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Farsight Enclaves battlesuit unit. The battlesuits move up to 6" toward the triggering unit; if this brings them within 1", they count as having charged and fight in the next Assault phase†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Devastating Counterstrike" id="957e-4765-578b-2396" hidden="false">
                  <description>the unit may re-roll to-wound rolls of 1 against targets within 12".</description>
                </rule>
                <rule name="Way of the Short Blade" id="c7b4-4577-7b41-ea84" hidden="false">
                  <description>Infantry and battlesuits add 1 to their Weapon Skill, to a maximum of 4.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Sa'cea" hidden="false" id="8b4c-b76c-7c6c-54e3" publicationId="733a-d454-80f2-c90e">
              <profiles>
                <profile name="Steady Volleys" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="2a86-133e-9f0f-63f6">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Sa'cea unit. The unit fires Overwatch with every model, and the charger subtracts 2 from its charge distance roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Calm Discipline" id="5caa-0ae9-489a-af75" hidden="false">
                  <description>the unit may re-roll to-hit rolls of 1 in a turn in which it did not move.</description>
                </rule>
                <rule name="Superior Training" id="2463-f182-04af-ae67" hidden="false">
                  <description>the unit adds 1 to its Ballistic Skill when firing Overwatch, to a maximum of 5.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="T'au Sept" hidden="false" id="12ac-4c07-6d31-6fec" publicationId="733a-d454-80f2-c90e">
              <profiles>
                <profile name="Mont'ka Strike" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="8719-3368-fe96-cf9b">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a T'au Sept unit is selected as the target of a Shooting Attack. The unit makes a Return Fire Shooting Attack before the enemy attack is resolved, instead of after it.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Cadre Discipline" id="ee68-0f64-603e-765a" hidden="false">
                  <description>the unit adds 1 to its Leadership, to a maximum of 10.</description>
                </rule>
                <rule name="Coordinated Fire" id="37fb-291f-7655-5a3e" hidden="false">
                  <description>when using Supporting Fire, up to two other units may fire Overwatch instead of one.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Vior'la" hidden="false" id="9ac4-0bee-5f8b-ff59" publicationId="733a-d454-80f2-c90e">
              <profiles>
                <profile name="Burning Charge" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="d376-a85e-da95-638a">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Vior'la unit. The Vior'la unit makes a Shooting Attack against the triggering unit, using only Rapid Fire and Assault weapons.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Hot-blooded" id="8d03-5532-4e73-4d24" hidden="false">
                  <description>Rapid Fire weapons fire one extra shot at targets within half range.</description>
                </rule>
                <rule name="Strike Fast" id="a046-a79a-e36f-ea2b" hidden="false">
                  <description>the unit may Advance and still shoot Rapid Fire and Assault weapons in the same turn†.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Warlord Trait" hidden="false" id="e448-30fb-324a-651e">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fc39-dbe5-897a-8c30" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Master Engineer" hidden="true" id="6315-555e-0069-4834" publicationId="733a-d454-80f2-c90e">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="d7f9-fabb-7ea9-16dd" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Master Engineer" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="ac15-9d92-a908-3c91">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">One weapon carried by the Warlord gains Master-crafted. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Shooting phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="1176-913e-e321-4be6" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Unbreakable Defender" hidden="true" id="dadd-a14d-1d0b-bff1" publicationId="733a-d454-80f2-c90e">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="1584-56ec-4e92-6834" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Unbreakable Defender" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="c442-93fb-3c39-c521">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord and any unit he joins gain Shrouded (5+) while in cover. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Shooting phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="a877-3c1d-6a81-5c65" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Martial Mastery" hidden="true" id="6164-5e88-0f77-cad3" publicationId="733a-d454-80f2-c90e">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="191a-9933-373a-bd05" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Martial Mastery" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="53e0-ead9-e9c5-cbfc">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord adds 1 to his Attacks, and his melee weapons gain Rending (6+). In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Assault phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="d19b-7733-2149-dc35" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Disciplined Commander" hidden="true" id="27b7-b5fb-b51a-d701" publicationId="733a-d454-80f2-c90e">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="8b4c-b76c-7c6c-54e3" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Disciplined Commander" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="f4d1-42ad-a368-8984">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Friendly Sa'cea units within 12" of the Warlord use his Leadership. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Assault phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="e145-07cc-725d-d171" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Master of the Hunter Cadre" hidden="true" id="f120-f904-5bd2-9dc0" publicationId="733a-d454-80f2-c90e">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="12ac-4c07-6d31-6fec" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Master of the Hunter Cadre" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="e280-6af6-8bc2-8b32">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Friendly T'au units within 12" of the Warlord may re-roll to-hit rolls of 1 against units with at least one Markerlight token. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Shooting phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="8f57-c2e0-8281-d085" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Fiery Commander" hidden="true" id="c5ce-9a36-7d05-883b" publicationId="733a-d454-80f2-c90e">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="9ac4-0bee-5f8b-ff59" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Fiery Commander" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="abe8-8a8a-bb11-398a">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord and any unit he joins may re-roll to-wound rolls of 1 with Rapid Fire weapons. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Movement phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="a92d-083c-1bb2-0a55" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
      </costs>
    </selectionEntry>
