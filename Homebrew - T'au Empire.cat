    <selectionEntry type="unit" import="true" name="Tidewall Gunrig" hidden="false" id="10e4-e404-7aed-2404" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Energy Shield" id="384b-7e49-452c-5d75" hidden="false">
          <description>friendly units within 3" of the Shieldline and behind it from the attacker's point of view have a 5+ Invulnerable Save against Shooting Attacks</description>
        </rule>
        <rule name="Manned Weapon" id="9c7c-d4ba-b11b-dbac" hidden="false">
          <description>The supremacy railgun may only fire if a friendly T'au Infantry unit is within 1" of the Gunrig; that unit may not shoot in the same phase</description>
