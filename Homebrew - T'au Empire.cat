    <selectionEntry type="unit" import="true" name="Darkstrider" hidden="false" id="c951-ad19-7bc8-7075" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Fighting Retreat" id="4cd9-1d4e-1e5c-87c2" hidden="false">
          <description>Once per game, at the end of the enemy Shooting phase, his unit may move up to 6"</description>
        </rule>
        <rule name="Structural Analyser" id="cc53-5f61-f492-1635" hidden="false">
          <description>The unit he joins may re-roll to-wound rolls of 1 with ranged weapons</description>
