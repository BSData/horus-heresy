    <selectionEntry type="unit" import="true" name="Pathfinder Kill Team" hidden="false" id="9498-c81f-30dc-0c38" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Communications Specialist" id="100a-c63d-b08d-edd2" hidden="false">
          <description>While he lives, the unit may re-roll failed Reserves rolls, and friendly units spending this unit's Markerlight tokens gain one extra token's effect</description>
        </rule>
        <rule name="Drone Specialist" id="972e-d894-76c3-4d5b" hidden="false">
          <description>Drones in the unit use the Drone Controller's Ballistic Skill while he lives</description>
        </rule>
        <rule name="Medical Technician" id="fea9-1406-8185-d00f" hidden="false">
          <description>While he lives, the unit has Feel No Pain (6+)</description>
        </rule>
        <rule name="Transpectral Interference" id="fe89-a31b-9b4a-bbfa" hidden="false">
          <description>While he lives, enemy units targeted by the unit do not receive cover saves from Stealth or Shrouded</description>
        </rule>
      </rules>
