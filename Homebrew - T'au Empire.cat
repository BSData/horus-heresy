    <selectionEntry type="unit" import="true" name="Farstalker Kinband" hidden="false" id="f758-b3f7-4dd2-9451" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Cold-blooded" id="848a-bc1e-322a-f5ee" hidden="false">
          <description>While he lives, the unit may re-roll failed Morale checks and Pinning tests</description>
        </rule>
        <rule name="Pistolier" id="d0ef-7ed8-58b3-f89b" hidden="false">
          <description>May fire both Kroot pistols in the Shooting phase, and may use them in close combat as an extra Attack</description>
        </rule>
        <rule name="Stalker" id="c4d8-4f77-f1e4-41b8" hidden="false">
          <description>May move up to 6" after deployment and before the first turn</description>
        </rule>
        <rule name="Tracker" id="0416-1cc4-a291-9b67" hidden="false">
          <description>While he lives, the unit ignores Stealth and Shrouded on its targets</description>
        </rule>
      </rules>
