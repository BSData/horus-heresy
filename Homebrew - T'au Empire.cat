    <selectionEntry type="unit" import="true" name="Commander Farsight" hidden="false" id="8fad-1c26-d092-af47" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Supreme Commander" id="051d-2121-4d00-43b4" hidden="false">
          <description>If he is in your army, Farsight must be your Warlord</description>
        </rule>
        <rule name="Way of the Short Blade" id="48de-d598-5899-4937" hidden="false">
          <description>Farsight and any unit he joins gain Furious Charge (1)</description>
        </rule>
        <rule name="XV-86 Supernova Battlesuit" id="a5e9-6138-3176-158d" hidden="false">
          <description>Farsight's jet pack move in the Shooting phase is 9" instead of 6", and once per game he may re-roll all failed to-hit and to-wound rolls in one Assault phase</description>
        </rule>
