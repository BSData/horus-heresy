    <selectionEntry type="unit" import="true" name="XV84 Crisis Battlesuits" hidden="false" id="e0f1-1201-7887-f79b" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Drone Network" id="0f6e-a734-acf3-8bc0" hidden="false">
          <description>Drones in the unit, and friendly drone units within 6", use the XV84's Ballistic Skill</description>
        </rule>
        <rule name="Networked Markerlight" id="df87-1a4d-8d06-6b62" hidden="false">
          <description>The unit may spend its own Markerlight tokens in the same Shooting phase it placed them</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="d87a-be0c-6e4b-8cd9" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
