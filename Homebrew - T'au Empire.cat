          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Effect: The bearer gains Hit and Run†, Cost: +5 points</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Velocity tracker*" hidden="false" id="1770-f862-7caa-edeb" publicationId="733a-d454-80f2-c90e">
      <profiles>
