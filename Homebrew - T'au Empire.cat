    <selectionEntry type="unit" import="true" name="Kroot Flesh Shaper" hidden="false" id="d1a1-9630-f91a-65a7" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Feast of the Fallen" id="ab59-9be8-6617-47d0" hidden="false">
          <description>The unit he joins has Feel No Pain (6+), and once per game, after destroying an enemy unit in close combat, adds 1 to its Strength until the end of the game</description>
        </rule>
