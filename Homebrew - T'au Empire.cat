    <selectionEntry type="unit" import="true" name="Aun'Va" hidden="false" id="6c18-930c-1175-3959" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Bodyguard" id="e0b5-ffb6-018a-87bd" hidden="false">
          <description>While an Ethereal Guard is alive, wounds allocated to Aun'Va are allocated to an Ethereal Guard instead</description>
        </rule>
        <rule name="Martyrdom" id="c5d7-4f45-2ecc-5d96" hidden="false">
          <description>if the Ethereal is slain, every friendly T'au unit within 12" must take a Morale check, but gains Rage (2) for the rest of the game</description>
        </rule>
        <rule name="Supreme Loyalty (as Ethereal, 24&quot;)" id="ba12-5d69-5512-85d6" hidden="false">
          <description>Supreme Loyalty (as Ethereal, 24")</description>
        </rule>
