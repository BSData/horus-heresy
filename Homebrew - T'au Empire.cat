    <selectionEntry type="unit" import="true" name="The Twin Lance" hidden="false" id="8732-08e0-f0dd-6abb" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Bonded Twins" id="51ae-0fc0-2851-4e5e" hidden="false">
          <description>If one Exemplar is slain, the other gains Rage (2) and Feel No Pain (5+) for the rest of the game</description>
        </rule>
        <rule name="Kinetic Shockwave" id="1846-5773-7c8d-cfc8" hidden="false">
          <description>Once per game, after the unit shoots, every enemy unit within 6" suffers D6 hits at Strength 5, AP 5, Concussive (1). The Twin Lance may then move up to 6" in any direction, even if engaged</description>
        </rule>
        <rule name="Masters of Mont'ka" id="aaa4-d4b5-dd76-8dd4" hidden="false">
          <description>The unit may Advance and still shoot in the same turn, and adds 1 to its Ballistic Skill against targets within 12"</description>
        </rule>
        <rule name="Neocapacitor Shields" id="5430-e5e4-0d37-6b65" hidden="false">
          <description>Each Exemplar has a 4+ Invulnerable Save</description>
        </rule>
        <rule name="Point-blank Killers" id="2915-2627-facb-7323" hidden="false">
          <description>When the unit fights in close combat, each Exemplar may make a Shooting Attack with its battlesuit pulse pistol instead of its normal Attacks, at Initiative 4</description>
        </rule>
        <rule name="Note" id="c3da-62e6-1d33-22da" hidden="false">
          <description>The Twin Lance may not join other units, and no character may join them</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="50e3-f96b-e9c6-63ac" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
