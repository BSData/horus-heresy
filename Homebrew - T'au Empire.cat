    <selectionEntry type="unit" import="true" name="Ethereal" hidden="false" id="9eea-5713-d22e-29ab" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Martyrdom" id="f16c-ab8f-ca55-a902" hidden="false">
          <description>If the Ethereal is slain, every friendly T'au unit within 12" must take a Morale check, but gains Rage (2) for the rest of the game</description>
        </rule>
        <rule name="Supreme Loyalty" id="40d2-b621-94c7-939d" hidden="false">
          <description>Friendly T'au units within 12" may use the Ethereal's Leadership</description>
        </rule>
