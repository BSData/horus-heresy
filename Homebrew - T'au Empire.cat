    <selectionEntry type="upgrade" import="true" name="Counterfire defence system*" hidden="false" id="5e66-570f-4525-4152" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Counterfire defence system*" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e333-5a81-006a-0011">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Effect: The bearer adds 1 to its Ballistic Skill when firing Overwatch, Cost: +5 points</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Drone controller" hidden="false" id="f5bd-579d-cbc3-ff7a" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Drone controller" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="4d4e-be7e-4a5d-0ddd">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Effect: Drones in the bearer's unit use its Ballistic Skill, Cost: +5 points</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Early warning override*" hidden="false" id="38dc-9e5b-ef60-069b" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Early warning override*" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9717-96fd-ac8f-6b42">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Effect: The bearer gains Interceptor†, Cost: +5 points</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Multi-tracker" hidden="false" id="7050-3aac-f803-c404" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Multi-tracker" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="fb64-bd4f-2926-5a34">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Effect: If all of the bearer's weapons fire at the same target, it may re-roll to-hit rolls of 1, Cost: +5 points</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Shield generator" hidden="false" id="47e8-907d-9b3a-159d" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Shield generator" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="e8ca-b280-0f4c-4262">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Effect: The bearer has a 4+ Invulnerable Save, Cost: +20 points</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Stimulant injector*" hidden="false" id="036b-16bd-412e-21b2" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Stimulant injector*" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="b0c1-4d5a-5d39-f3d3">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Effect: The bearer has Feel No Pain (6+), Cost: +10 points</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Target lock" hidden="false" id="c16d-3fbc-3f22-b430" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Target lock" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="0cab-cbed-a626-5596">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Effect: The bearer may shoot a different target from the rest of its unit, Cost: +5 points</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Vectored retro-thrusters" hidden="false" id="a2f2-9a6c-38bd-c6f5" publicationId="733a-d454-80f2-c90e">
      <profiles>
