    <selectionEntry type="unit" import="true" name="Sky Ray Gunship" hidden="false" id="c7cb-2b77-d646-ba92" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Drone Docking" id="4665-605b-c4e7-6c8f" hidden="false">
          <description>the Gun Drones start the game docked on the Devilfish and fire as its weapons. At the start of any of your Movement phases, they may launch as a separate unit of Gun Drones within 3" of the hull</description>
        </rule>
        <rule name="Networked Markerlights" id="45cd-63dd-f213-1840" hidden="false">
          <description>The Sky Ray may spend its own Markerlight tokens on its seeker missiles in the same Shooting phase</description>
        </rule>
        <rule name="Velocity Tracker" id="2deb-df99-1ab3-85a3" hidden="false">
          <description>The Sky Ray's seeker missiles gain Skyfire</description>
