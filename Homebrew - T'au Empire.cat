    <selectionEntry type="unit" import="true" name="DX-4 Technical Drones" hidden="false" id="58d9-e67d-8f86-35e3" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Defence Charge" id="c166-15c1-7993-f51b" hidden="false">
          <description>Once per game, in the Assault phase, the unit may detonate its defence charges; every enemy unit in 3” suffers D3 hits at Strength 6, AP 4 per drone. The drones are then removed as casualties.</description>
        </rule>
        <rule name="Field Repairs" id="84ab-3880-f539-eeaf" hidden="false">
          <description>The unit has Battlesmith (5+), usable on friendly T'au vehicles, battlesuits, Knights and Titans</description>
        </rule>
