    <selectionEntry type="unit" import="true" name="Tidewall Shieldline" hidden="false" id="ee8f-6b6a-f432-525e" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Energy Shield" id="3588-e93f-6281-1004" hidden="false">
          <description>Friendly units within 3" of the Shieldline and behind it from the attacker's point of view have a 5+ Invulnerable Save against Shooting Attacks</description>
        </rule>
        <rule name="Reflective Field" id="8fa8-70b6-e9c3-92dc" hidden="false">
