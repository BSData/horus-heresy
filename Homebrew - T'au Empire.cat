    <selectionEntry type="unit" import="true" name="Crisis Bodyguards" hidden="false" id="1ebd-e776-6ef5-7dff" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Bonding Knife Ritual" id="e7f7-745a-a8a8-8b3a" hidden="false">
          <description>The unit may re-roll failed Morale checks</description>
        </rule>
        <rule name="Sworn Protectors" id="ddd6-e32d-24be-747f" hidden="false">
          <description>While a Commander has joined the unit, any Bodyguard may take wounds allocated to him as Look Out, Sir! on a 2+</description>
        </rule>
