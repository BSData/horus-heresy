    <selectionEntry type="unit" import="true" name="Sub-commander Torchstar" hidden="false" id="10cc-63aa-684f-25b6" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Purge the Unworthy" id="9e08-7514-255a-60a7" hidden="false">
          <description>Torchstar's flamers gain Shred, and she may re-roll to-wound rolls of 1 against units that hold an objective</description>
