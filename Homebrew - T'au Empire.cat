    <selectionEntry type="unit" import="true" name="KV128 Stormsurge" hidden="false" id="0075-950d-1154-12cb" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Ground Stomp" id="427d-dd54-c33b-5af8" hidden="false">
          <description>Enemy Infantry units charging the Stormsurge subtract 2 from their charge distance</description>
        </rule>
        <rule name="Shield Generator" id="4159-d676-7108-87a0" hidden="false">
          <description>The Stormsurge has a 5+ Invulnerable Save against Shooting Attacks</description>
        </rule>
        <rule name="Stabilising Anchors" id="411a-abcd-e15f-9f43" hidden="false">
          <description>At the start of your Shooting phase, if the Stormsurge did not move this turn, it may deploy its anchors. It then adds 1 to its Ballistic Skill and may fire every weapon it carries, but may not move in your next turn</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="e22d-93cd-c1bd-350f" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
