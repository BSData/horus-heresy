    <selectionEntry type="unit" import="true" name="Riptide" hidden="false" id="8b0a-dbd7-d8a9-7060" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Nova Reactor" id="88ab-1a54-08ec-9164" hidden="false">
          <description>At the start of your Shooting phase, the Riptide may take a Leadership test; if it passes, choose one: its heavy burst cannon fires 12 shots, its Shooting phase jet pack move is increased to 12", or its shield generator gives a 3+ Invulnerable Save until your next turn. If it fails, the Riptide loses one Wound with no saves allowed</description>
        </rule>
