          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Effect: The bearer's weapons gain Skyfire, Cost: +5 points</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Disruption Pod" hidden="false" id="1b2c-2470-fa32-e61c" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Disruption Pod" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="698c-714f-1ea6-fec8">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A vehicle-mounted system that distorts the vehicle's image. A vehicle with a disruption pod has Shrouded (6+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Homing Beacon" hidden="false" id="7d9a-12d3-479c-a341" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Homing Beacon" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="46d5-9ff6-70e6-7fcc">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A transmitter that guides incoming battlesuits to their drop point. Friendly units arriving by Deep Strike within 6" of a model with a homing beacon do not scatter.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Hover Drone" hidden="false" id="5f52-ab15-6443-c2d2" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Hover Drone" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3ae3-dd0e-be8f-e86b">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A personal drone that carries an Ethereal into battle. An Ethereal with a hover drone counts as having a jet pack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Photon Grenades" hidden="false" id="6fc1-7d02-98ce-6693" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Photon Grenades" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="08b5-d0eb-d111-f1f2">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Grenades that release a blinding flash. Enemy units that charge a unit with photon grenades do not gain the Initiative bonus for charging, and subtract 1 from their Leadership until the end of the phase†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Point Defence Targeting Relay" hidden="false" id="de78-0ba8-e792-6f49" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Point Defence Targeting Relay" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="16cc-c62c-3cf6-1fb8">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">An automated fire-control system for defensive fire. A vehicle with a point defence targeting relay adds 1 to its Ballistic Skill when firing Overwatch.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Vespid Wings" hidden="false" id="788e-9a00-9be3-ad94" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Vespid Wings" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="d82a-72b3-265a-dea6">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The crystalline wings of the Vespid, letting them hover and dart across the battlefield. Vespid Wings count as a jump pack. A model with Vespid Wings follows all the rules for a Legion Warhawk jump pack†, under the name Vespid Wings.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Broadside Battlesuit" hidden="false" id="e7d5-7a9f-a60a-674f" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Broadside Battlesuit" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7001-b110-75bc-a721">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The heavily armoured XV88, a walking gun platform. A Broadside battlesuit confers a 2+ Armour Save and Bulky (4). It does not confer a jet pack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Combat Armour" hidden="false" id="c689-8682-73e3-c921" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Combat Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="8a93-c1a8-a3e2-b3ca">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The standard armour of the Fire Caste, light but strong. Combat armour confers a 4+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Crisis Battlesuit" hidden="false" id="7f16-d91d-1595-5b5a" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Crisis Battlesuit" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="7c07-0019-3ab0-7121">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The XV8 Crisis battlesuit, mainstay of the Fire Caste's elite. A Crisis battlesuit confers a 3+ Armour Save, a jet pack and Bulky (3).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Iridium Armour" hidden="false" id="d622-9c99-9fd4-cb8c" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Iridium Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="4b9d-ec92-776d-58e7">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Dense iridium plating worn only by Commanders. A Commander with iridium armour has a 2+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Recon Armour" hidden="false" id="f202-6a4b-bc3d-8232" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Recon Armour" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="96fe-f122-62fa-c09d">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Light armour worn by Pathfinders and Ethereals, built for speed and stealth. Recon armour confers a 5+ Armour Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Stealth Battlesuit" hidden="false" id="7a95-95e8-8bd1-7f3f" publicationId="733a-d454-80f2-c90e">
      <profiles>
        <profile name="Stealth Battlesuit" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="3d34-ae65-0d4d-61ff">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The XV25 and XV22 stealth suits, cloaked by advanced sensor-baffling fields. A Stealth battlesuit confers a 3+ Armour Save, a jet pack, Bulky (2), Stealth and Shrouded (5+).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Command and control node" hidden="false" id="8887-780f-01d1-4b56" publicationId="733a-d454-80f2-c90e">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="1fdc-e0de-d37a-dcbd" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Command and control node" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="2949-f1b8-2417-4339">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Once per turn, one friendly T'au unit within 12" may re-roll failed to-hit rolls when it shoots the same target as the bearer</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Failsafe detonator (battlesuit only)" hidden="false" id="e962-c4b0-31c1-1f6a" publicationId="733a-d454-80f2-c90e">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="75d3-cb2f-1fe1-d504" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Failsafe detonator (battlesuit only)" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="2521-bdeb-d34e-3635">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">When the bearer is slain, every unit within 3" suffers D6 hits at Strength 6, AP 4</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Multi-spectrum sensor suite" hidden="false" id="40f0-3237-d430-4a67" publicationId="733a-d454-80f2-c90e">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="7aba-d3ba-5e36-f27a" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Multi-spectrum sensor suite" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="92d3-1c4e-0083-0593">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Friendly T'au units within 12" ignore cover saves granted by Stealth and Shrouded</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Neuroweb system jammer" hidden="false" id="be29-f3c8-765d-0901" publicationId="733a-d454-80f2-c90e">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="1f0b-7e47-23c1-37c8" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Neuroweb system jammer" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="cbbe-0077-ce37-00cc">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Once per Shooting phase, one enemy unit within 18" must re-roll successful to-hit rolls of 6 for Gets Hot weapons, and its Haywire and Psychic weapons subtract 1 from to-hit rolls</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Onager gauntlet (battlesuit only)" hidden="false" id="aeef-f14a-ecd7-ab1c" publicationId="733a-d454-80f2-c90e">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="2c10-f443-6198-7f62" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Onager gauntlet (battlesuit only)" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="890a-41ee-2669-8212">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Replaces one weapon: melee, S10, AP 1, Armourbane (Melee); one attack only each fight</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Puretide engram neurochip" hidden="false" id="b6d1-12ef-a946-760e" publicationId="733a-d454-80f2-c90e">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="6508-a3f5-25bd-5814" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
