    <selectionEntry type="unit" import="true" name="Shas'vre Ob'lotai 9-0" hidden="false" id="e910-13e3-7690-9461" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Calculated Fire" id="f69a-4d2a-ceae-6267" hidden="false">
          <description>Ob'lotai 9-0 may re-roll to-hit rolls of 1, and to-wound and armour penetration rolls of 1 against Vehicles and Knights</description>
        </rule>
        <rule name="Firing Platform (as Broadside)" id="f9ff-57fe-073e-59c8" hidden="false">
          <description>Firing Platform (as Broadside)</description>
        </rule>
        <rule name="Remote Pilot" id="1c1c-dc9c-7f96-99eb" hidden="false">
