    <selectionEntry type="unit" import="true" name="KX139 Ta'unar Supremacy Armour" hidden="false" id="b8f4-232c-fa0e-f2d3" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Shield Generator" id="cfbb-1fc4-41f6-9c3b" hidden="false">
          <description>The Ta'unar has a 4+ Invulnerable Save against Shooting Attacks</description>
        </rule>
        <rule name="Stabilising Anchors" id="c3c8-9aff-cb44-7263" hidden="false">
          <description>at the start of your Shooting phase, if the Stormsurge did not move this turn, it may deploy its anchors. It then adds 1 to its Ballistic Skill and may fire every weapon it carries, but may not move in your next turn</description>
        </rule>
        <rule name="Supremacy Armour" id="674c-21d4-b98a-bbf5" hidden="false">
          <description>The Ta'unar may fire every weapon it carries, at different targets if you wish</description>
        </rule>
      </rules>
