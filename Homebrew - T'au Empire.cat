    <selectionEntry type="unit" import="true" name="Tidewall Droneport" hidden="false" id="0cd7-f3e4-d4ef-07ce" publicationId="733a-d454-80f2-c90e">
      <rules>
        <rule name="Drone Launch" id="a9f6-37c0-d043-d79a" hidden="false">
          <description>The Gun Drones start docked. At the start of any of your Movement phases, they may launch as a separate unit within 3" of the Droneport. While docked, they fire as the Droneport's weapons</description>
        </rule>
        <rule name="Drone Recall" id="e84d-f4a5-2cd5-277f" hidden="false">
          <description>At the end of your Movement phase, a unit of drones from this Droneport within 3" may re-dock.</description>
        </rule>
        <rule name="Energy Shield" id="41d4-331d-ee14-35b2" hidden="false">
          <description>friendly units within 3" of the Shieldline and behind it from the attacker's point of view have a 5+ Invulnerable Save against Shooting Attacks</description>
        </rule>
      </rules>
