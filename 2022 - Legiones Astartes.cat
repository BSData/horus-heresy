<profiles>
<profile id="9184-0290-6d7c-aeb9" name="Warp Walker" publicationId="0b44-e890-1d51-5b89" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
<characteristics>
<characteristic name="Description" typeId="347e-ee4a-764f-6be3">The unit gains Deep Strike, and Fear (2) in any turn it arrives by Deep Strike.</characteristic>
