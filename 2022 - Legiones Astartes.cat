        <infoLink name="Relentless" hidden="false" type="rule" targetId="7adf-ac9a-5035-522d" id="ff6a-ed3d-441a-a4a7"/>
      </infoLinks>
      <rules>
        <rule name="Strength of the Legion" id="90dd-85d9-2d70-5ffa" hidden="false">
          <description>A unit which contains one or more models with this special rule automatically passes Leadership tests made to Regroup. Additionally, a unit containing one or more models with this special rule which has Regrouped this turn suffers no restriction on its ability to Charge or make Shooting Attacks due to having Regrouped in the same turn.</description>
        </rule>
      </rules>
