        <selectionEntry id="94dd-c8ba-d174-5c53" name="SoH Decurion Lanius" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="force" value="0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="01b4-57c7-bf61-2abf" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile id="a12a-cd0b-c070-d447" name="SoH Decurion Lanius" publicationId="53a4-0d21-2f8a-2c45" page="218" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="347e-ee4a-764f-6be3">This upgrade can be purchased for any one model with the Legiones Astartes (Sons of Horus) special rule that has not been upgraded with a Pintle Mounted weapon of any kind and is part of any of the following units:
• Legion Predator Squadron
• Legion Sicaran Squadron
• Legion Sicaran Punisher Squadron
• Legion Kratos Squadron

Special Rules
A model with this upgrade gains the Decurion Lanius special rule.

Wargear
A model with this upgrade gains a Pintle Mounted banestrike bolt cannon.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="42fe-420f-a144-b7e9" name="Decurion Lanius" publicationId="53a4-0d21-2f8a-2c45" page="218" hidden="false">
              <description>All friendly models with the Legiones Astartes (Sons of Horus) special rule that are within 12&quot; of any models with this special rule are considered to have a Leadership Characteristic of 9 (unless it would normally be higher) when resolving Morale checks or Pinning tests made during the Shooting phase only. If a friendly unit with the Legiones Astartes (Sons of Horus) special rule that is within 12&quot; of and within line of sight of any models with this special rule fails a Morale check or Pinning test during the Shooting phase, that unit suffers D3 Wounds against which no Saves of any kind may be taken, but Damage Mitigation rolls may be made as normal and that Morale check or Pinning test is considered to have been passed.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry id="3bfb-69ae-691e-645c" name="Banestrike Bolt Cannon" publicationId="53a4-0d21-2f8a-2c45" page="218" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8bc4-ecbb-0108-e05c" type="min"/>
