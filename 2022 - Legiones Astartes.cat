    <selectionEntry id="16ca-e521-1c1b-0716" name="Gorgon Terminator Armour" hidden="true" collective="false" import="true" type="upgrade">
      <modifiers>
        <modifier type="set" field="hidden" value="false">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition type="instanceOf" value="1" field="selections" scope="ancestor" childId="cf47-4aef-a6db-782d" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
                <condition type="equalTo" value="1" field="selections" scope="force" childId="bfc9-c99c-bf8a-3917" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </conditions>
