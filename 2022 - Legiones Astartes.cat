<profiles>
<profile id="132a-59aa-ef57-0d59" name="Toxic Breath" publicationId="0b44-e890-1d51-5b89" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
<characteristics>
<characteristic name="Description" typeId="347e-ee4a-764f-6be3">The unit gains Hammer of Wrath (1), and its Hammer of Wrath hits have Poisoned (4+). A unit that already has Hammer of Wrath keeps its value instead, and those hits gain Poisoned (3+).</characteristic>
