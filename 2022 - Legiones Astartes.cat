        <infoLink id="2c31-c5fa-cf8b-dee2" name="Legiones Hereticus (Emperor’s Children)" hidden="false" targetId="b9e-b2ef-86e-e52d" type="rule"/>
        <infoLink name="Support Squad" id="64ad-20cd-8803-cfc1" hidden="false" targetId="768e-56d6-ca52-24ae" type="rule">
          <modifiers>
