<cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0.0"/>
</costs>
</selectionEntry>
<selectionEntry id="d30c-e0fc-e11f-d1a9" name="Legiones Hereticus (Death Guard)" publicationId="0b44-e890-1d51-5b89" hidden="false" collective="false" import="true" type="upgrade">
<profiles>
<profile id="e1bd-f7b8-26bf-954e" name="Death Guard Advanced Reaction (Legiones Hereticus)" publicationId="0b44-e890-1d51-5b89" hidden="false" typeId="90b9-7fab-87db-aed3" typeName="Reactions">
<characteristics>
<characteristic name="Description" typeId="c627-4637-8de5-65fb">This Advanced Reaction is available only to units composed entirely of models with the Legiones Hereticus (Death Guard) special rule. It may be made once per battle and uses a point of the Reaction Allotment as normal.

Disgustingly Resilient – (Shooting phase, once per battle). Trigger: an enemy unit declares a Shooting Attack targeting a unit with this rule. Against that attack, every model in the reacting unit improves its Feel No Pain by a further 1, to a best of 4+.</characteristic>
</characteristics>
</profile>
</profiles>
<infoLinks>
<infoLink id="ef36-4468-6b18-ec44" name="Legiones Hereticus (Death Guard)" hidden="false" targetId="7417-5bb1-54d7-d9ea" type="rule"/>
</infoLinks>
