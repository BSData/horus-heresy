    <selectionEntry id="3f61-86fe-eecf-aed7" name="Sonic Shriekers" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="70d4-a0bf-ff5a-5e49" name="Sonic Shriekers" page="154" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">During a turn in which a unit with at least one model equipped with sonic shriekers Successfully Charges, or themselves successfully Charged, all models in any enemy unit(s) locked in combat with them suffer a -1 penalty to all To Hit rolls, Models which are immunte to the effect of the Fear (X) special rule are not affected by this modifier.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="ddd0-22b3-ea96-680d" name="Sub-sonic Pulser" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="519d-6150-5186-75ca" name="Sub-sonic Pulser" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model equipped with this upgrade, and any unit it joins, ignores the penalties to Leadership and Ballistic Skill imposed by the Night Fighting special rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs>
        <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="e8a8-b526-beab-bb82" name="Spatha Combat Bike" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
