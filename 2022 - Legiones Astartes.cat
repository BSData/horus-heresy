<profiles>
<profile id="a532-2db3-65ac-7215" name="Warlord: Sire of the Word Bearers" publicationId="0b44-e890-1d51-5b89" hidden="false" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait">
<characteristics>
<characteristic name="Text" typeId="c68e-2cda-b67b-baca">All units composed entirely of models with Legiones Hereticus (Word Bearers) that can draw line of sight to the Warlord add +1 to their Charge distance rolls, and may use the Warlord&apos;s Leadership for all Leadership tests, Morale checks and Pinning tests. In addition, the army gains an extra Reaction in the opposing player&apos;s Assault phase, as long as the Warlord has not been removed as a casualty.</characteristic>
</characteristics>
</profile>
</profiles>
</entryLink>
