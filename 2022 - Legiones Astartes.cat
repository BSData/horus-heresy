        <entryLink id="1519-cd4a-2df8-31ef" name="Inductii" hidden="true" collective="false" import="true" targetId="8e05-7d1e-16e4-1669" type="selectionEntry">
          <modifiers>
            <modifier type="set" field="hidden" value="false">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition type="equalTo" value="1" field="selections" scope="force" childId="c0df-c1fa-5ddc-9ee5" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
                        <condition type="equalTo" value="1" field="selections" scope="force" childId="b2b4-2198-0b90-dd9f" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
                        <condition type="equalTo" value="1" field="selections" scope="force" childId="dd1f-1c51-706c-e5f7" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
                        <condition type="equalTo" value="1" field="selections" scope="force" childId="a0e1-f2c4-8bcd-0723" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
                        <condition type="equalTo" value="1" field="selections" scope="force" childId="bfc9-c99c-bf8a-3917" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
                        <condition type="equalTo" value="1" field="selections" scope="force" childId="5f54-457a-fbb9-6730" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
