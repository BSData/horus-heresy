      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition type="equalTo" value="0" field="selections" scope="force" childId="dd1f-1c51-706c-e5f7" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
                <condition type="notInstanceOf" value="1" field="selections" scope="ancestor" childId="2c0c-9795-7668-b133" shared="true" percentValue="false" includeChildSelections="true" includeChildForces="false"/>
              </conditions>
