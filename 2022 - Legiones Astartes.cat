<selectionEntry id="afcb-0613-1704-fb78" name="Legiones Hereticus (Alpha Legion)" publicationId="0b44-e890-1d51-5b89" hidden="false" collective="false" import="true" type="upgrade">
<profiles>
<profile id="2dde-5087-069e-b082" name="Alpha Legion Advanced Reaction (Legiones Hereticus)" publicationId="0b44-e890-1d51-5b89" hidden="false" typeId="90b9-7fab-87db-aed3" typeName="Reactions">
<characteristics>
<characteristic name="Description" typeId="c627-4637-8de5-65fb">This Advanced Reaction is available only to units composed entirely of models with the Legiones Hereticus (Alpha Legion) special rule. It may be made once per battle and uses a point of the Reaction Allotment as normal.

Hydra&apos;s Deceit – (Movement phase, once per battle). Trigger: an enemy unit ends a move within 12&quot; of a unit with this rule. The reacting unit may immediately move up to its Movement Characteristic, but may not end within 1&quot; of an enemy model.</characteristic>
</characteristics>
</profile>
</profiles>
<infoLinks>
<infoLink id="fa1c-69b8-e913-510d" name="Legiones Hereticus (Alpha Legion)" hidden="false" targetId="d0a9-3362-1995-9f39" type="rule"/>
</infoLinks>
<categoryLinks>
<categoryLink id="da67-6095-a489-59b4" name="Legiones Hereticus" hidden="false" targetId="d684-5b63-caa7-adc4" primary="false"/>
</categoryLinks>
