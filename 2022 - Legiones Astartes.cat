              </characteristics>
            </profile>
            <profile id="3324-fbfc-cb1f-4e9b" name="Point-blank" hidden="false" typeId="1a1a-e592-2849-a5c0" typeName="Weapon" publicationId="4934-46f7-208b-b4af" page="161">
