      </modifiers>
      <profiles>
        <profile id="dd47-98c1-af82-88f3" name="Æther-rune Armour" publicationId="817a-6288-e016-7469" page="200" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Æther-rune armour confers a 2+ Armour Save. In addition, it increases the Wounds Characteristic of a model with it by +1 and grants the Adamantium Will (4+) special rule to that model.</characteristic>
          </characteristics>
        </profile>
      </profiles>
