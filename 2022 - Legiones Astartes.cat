        <profile id="0f09-cbd9-a8be-5706" name="Two Gravis power fists with in-built Pyroclast Flame Projectors.*" publicationId="d0df-7166-5cd3-89fd" page="69" hidden="false" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">*The additional close combat attacks are already included in profile.</characteristic>
          </characteristics>
        </profile>
