    <selectionEntry type="unit" import="true" name="Mawloc" hidden="false" id="d0d0-502a-4be4-5a59" publicationId="7478-cf16-4f88-170b">
      <rules>
        <rule name="Terror from the Deep" id="99e7-2491-64f4-d70a" hidden="false">
          <description>When the Mawloc arrives by Deep Strike, it may be placed on top of an enemy unit. Place a Large Blast (5") marker where it will land; every model under it suffers a hit at Strength 6, AP 2. Enemy models are then moved the minimum distance to make room, and the Mawloc does not scatter</description>
        </rule>
      </rules>
