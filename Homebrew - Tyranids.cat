    <selectionEntry type="unit" import="true" name="Tervigon" hidden="false" id="0e80-3021-52c9-2f49" publicationId="7478-cf16-4f88-170b">
      <rules>
        <rule name="Brood Progenitor" id="cc4e-f3b0-aacd-cc18" hidden="false">
          <description>Friendly Termagant units within 6" have Furious Charge (1)</description>
        </rule>
        <rule name="Spawn Termagants" id="a0e3-c888-61a2-d044" hidden="false">
          <description>Once per turn, at the end of your Movement phase, place a new unit of 10 Termagants wholly within 6" of the Tervigon. Roll 3D6 first; on any double, no Termagants are spawned and the Tervigon may not spawn again this game</description>
        </rule>
      </rules>
