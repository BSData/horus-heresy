    <selectionEntry type="unit" import="true" name="Hierophant Bio-titan" hidden="false" id="464f-f8bb-bcbc-0648" publicationId="7478-cf16-4f88-170b">
      <rules>
        <rule name="Towering Bio-titan" id="1fc7-9647-bd4c-82d3" hidden="false">
          <description>The Hierophant may move over Infantry and Cavalry as though they were not there, and inflicts D6 Strength 8, AP 3 hits on each enemy unit it moves over</description>
        </rule>
      </rules>
      <infoLinks>
