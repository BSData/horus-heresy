          </modifiers>
        </infoLink>
      </infoLinks>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Adrenal Glands" hidden="false" id="d4e9-99f8-c287-dcd9" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Adrenal Glands" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="86dc-236b-358b-5f64">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with adrenal glands gains Fleet (1) and Furious Charge (1), or increases an existing value of either by 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Bone Mace and Thresher Scythe" hidden="false" id="36e7-a4db-5d93-146b" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Bone Mace and Thresher Scythe" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="ff1a-6094-218e-11af">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with a bone mace or thresher scythe tail makes additional Attacks in close combat as set by the Extra Attacks (X) rule on the tail's profile in the Bio-weapons armoury. A model may have only one tail biomorph.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Flesh Hooks" hidden="false" id="d875-07dc-1a2b-eeb6" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Flesh Hooks" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="b9e0-10da-31b3-695a">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Flesh hooks count as frag grenades†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Prehensile Pincer Tail" hidden="false" id="c858-9743-0561-0ff7" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Prehensile Pincer Tail" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="75f4-c5ef-26a4-976a">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with a prehensile pincer tail makes additional Attacks in close combat as set by the Extra Attacks (X) rule on the tail's profile in the Bio-weapons armoury. A model may have only one tail biomorph.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Regeneration" hidden="false" id="8c29-c3bc-4244-b568" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Regeneration" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9a5a-0a5f-7849-ab08">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">A model with regeneration gains Regeneration (X): at the end of each of your turns, if the model has lost any Wounds, roll a D6. On a roll of X or more, it restores one lost Wound, up to its starting value.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Spine Banks" hidden="false" id="932f-22c7-261a-c9a7" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Spine Banks" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="fbd5-4b8b-116f-49e4">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Spine banks count as frag grenades†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Toxin Sacs" hidden="false" id="644e-956c-bbee-3079" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Toxin Sacs" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="f61f-0006-e8f6-cfa6">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The model's melee weapons gain Poisoned (4+), or improve an existing Poisoned value by 1, to a best of 2+†.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Unnatural Resilience" hidden="false" id="23db-a965-da27-c231" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Unnatural Resilience" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9736-678f-78f5-2e6e">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Only Monstrous models may take this biomorph. A model with it gains the Unnatural Resilience special rule (see Army-wide Special Rules).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Wings" hidden="false" id="541f-83f2-9505-5741" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Wings" typeId="2a1f-7837-f0ef-be44" typeName="Wargear Item" hidden="false" id="9cff-f445-dc66-5f2d">
          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Wings count as a jump pack and use the official 2.0 Jump Pack rules: a unit composed entirely of models with wings may set its Movement Characteristic to 12 for the controlling player's turn, gaining the bonus to Charge distance, ignoring terrain while Moving and Charging, and moving over friendly and enemy models (Dangerous Terrain tests still apply, and Difficult Terrain counts as Dangerous). Models with wings gain Bulky (2), or Bulky (3) if they already have Bulky (2), and Deep Strike. A winged unit may not Advance, and may not use its wings to gain a Movement bonus during a Reaction. Harpies and Hive Crones set their Movement to 18 instead of 12, and Harridans to 24. Gargoyles, Sky-Slasher Swarms, Tyranid Shrikes, Winged Tyranid Primes, the Parasite of Mortrex, Harpies, Hive Crones and Harridans always have wings. A Hive Tyrant with wings is often called a Flyrant.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Catalyst" hidden="false" id="1f75-a5c3-bd25-e42d" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Catalyst" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="4061-12c9-fbe4-1943">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">At the start of your Movement phase, the psyker may make a Psychic check. If the Check is passed, one friendly Tyranid unit within 12" gains Feel No Pain (5+), or improves an existing Feel No Pain by 1, until the start of your next turn. If the Check is failed, the psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Dominion" hidden="false" id="0fe0-302f-b8a3-6ec3" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Dominion" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="7929-2703-2873-207d">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">At the start of your Movement phase, the psyker may make a Psychic check. If the Check is passed, its Synapse Creature range becomes 18" until the start of your next turn. If the Check is failed, the psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Onslaught" hidden="false" id="832d-16d0-30ff-b505" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Onslaught" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="320a-81bf-d0de-d01e">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">At the start of your Movement phase, the psyker may make a Psychic check. If the Check is passed, one friendly Tyranid unit within 12" may Advance and still make Shooting Attacks this turn. If the Check is failed, the psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Paroxysm" hidden="false" id="3e41-9a5c-406c-2ba6" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Paroxysm" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="d61a-da9f-3a69-1c70">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Instead of making a Shooting Attack, the psyker may make a Psychic check. If the Check is passed, one enemy unit within 18" subtracts 1 from its Weapon Skill and Ballistic Skill until the start of your next turn. If the Check is failed, the psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="The Horror" hidden="false" id="b685-0629-a1e4-abce" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="The Horror" typeId="5405-b3c6-e8d0-4e77" typeName="Psychic Power" hidden="false" id="e545-af2f-2ec0-9103">
          <characteristics>
            <characteristic name="Description" typeId="4c0f-7e2f-586c-9305">Instead of making a Shooting Attack, the psyker may make a Psychic check. If the Check is passed, one enemy unit within 18" must take a Pinning test with a –2 modifier to its Leadership. If the Check is failed, the psyker suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="unit" import="true" name="Broodlord" hidden="false" id="421b-0e75-8fe9-86f7" publicationId="7478-cf16-4f88-170b">
      <rules>
        <rule name="Brood Telepathy" id="5509-10f0-5051-4d2d" hidden="false">
          <description>A Genestealer unit he joins re-rolls failed charge distances</description>
        </rule>
        <rule name="Independent Character restriction" id="1412-9986-56e3-2884" hidden="false">
