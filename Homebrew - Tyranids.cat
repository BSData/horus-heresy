    <selectionEntry type="unit" import="true" name="Mucolid Spores" hidden="false" id="2dbe-25d4-1eb9-e2f1" publicationId="7478-cf16-4f88-170b">
      <rules>
        <rule name="Floating Death" id="10a1-bdcb-309e-3808" hidden="false">
          <description>Spore Mines may not be targeted until they arrive, and may not claim or contest objectives</description>
        </rule>
        <rule name="Living Bomb" id="26aa-6c96-52e8-336e" hidden="false">
          <description>As Spore Mines, but the explosion is Large Blast (5"), Strength 6, AP 4</description>
        </rule>
      </rules>
