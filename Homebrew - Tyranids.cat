    <selectionEntry type="unit" import="true" name="Malanthrope" hidden="false" id="9108-5466-3efd-f50b" publicationId="7478-cf16-4f88-170b">
      <rules>
        <rule name="Harvester of the Dead" id="1262-5478-25b6-0269" hidden="false">
          <description>At the end of each Assault phase, if any models (friend or foe) were slain within 6" of the Malanthrope that phase, it restores one lost Wound, up to its starting value</description>
        </rule>
        <rule name="Spore Cloud (as Venomthropes)" id="7e2e-0ced-80a3-111d" hidden="false">
          <description>Friendly Tyranid units within 6" have Shrouded (5+)</description>
        </rule>
        <rule name="Toxic Miasma" id="432a-142d-9586-57a8" hidden="false">
          <description>At the start of each Assault phase, every enemy unit engaged with or within 3" of the Malanthrope suffers D3 hits at Strength 3, AP 5, with Poisoned (4+)</description>
        </rule>
        <rule name="Note" id="019f-605b-83f5-e0f1" hidden="false">
          <description>A floating synapse beast wreathed in toxic spores, which drifts across the battlefield harvesting the dead for the Hive Mind.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Hive Fleet (X)" id="2b37-1182-0ed0-9af4" hidden="false" targetId="6ef3-1641-fb7e-9d1f" type="rule" />
