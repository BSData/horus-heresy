    <selectionEntry type="upgrade" import="true" name="Psychic Scream" hidden="false" id="5215-d809-10f1-f2ff" publicationId="7478-cf16-4f88-170b">
      <profiles>
        <profile name="Psychic Scream" typeId="cede-0217-1b10-2a34" typeName="Psychic Weapon" hidden="false" id="f5a4-0a7b-6330-a0ca" publicationId="7478-cf16-4f88-170b">
          <characteristics>
