    <selectionEntry type="unit" import="true" name="Spore Mines" hidden="false" id="9063-cd44-1d65-fa35" publicationId="7478-cf16-4f88-170b">
      <rules>
        <rule name="Floating Death" id="7621-6453-4d4a-6d02" hidden="false">
          <description>Spore Mines may not be targeted until they arrive, and may not claim or contest objectives</description>
        </rule>
        <rule name="Living Bomb" id="c808-e214-ab6f-c27b" hidden="false">
          <description>If a Spore Mine moves into base contact with an enemy model, or is touched by an enemy model, it explodes: place a Blast (3") marker centred on it, resolve one hit at Strength 4, AP 4 on every model under it, then remove the Spore Mine</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Deep Strike" id="3b37-fa4d-77e7-00d2" hidden="false" targetId="f1e1-986f-c783-ca9e" type="rule" />
