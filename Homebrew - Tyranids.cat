    <selectionEntry type="unit" import="true" name="The Red Terror" hidden="false" id="f911-c92b-6d8b-91f0" publicationId="7478-cf16-4f88-170b">
      <rules>
        <rule name="Swallow Whole" id="d0d4-7f9d-34cd-9fb9" hidden="false">
