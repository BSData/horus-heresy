    <selectionEntry type="unit" import="true" name="Meiotic Spores" hidden="false" id="dfc0-1afd-d6f9-db2c" publicationId="7478-cf16-4f88-170b">
      <rules>
        <rule name="Drifting Death" id="076d-db54-b084-9104" hidden="false">
          <description>The unit must always move as far as possible toward the nearest visible enemy unit, and may not shoot, charge or be locked in combat</description>
        </rule>
        <rule name="Living Bomb" id="14e6-bb64-dcf0-c8e8" hidden="false">
          <description>If a Meiotic Spore ends its move within 1" of an enemy model, or is slain, it bursts. Centre a Large Blast (5") on it; every unit under the marker suffers a hit at Strength 6, AP 4, with Poisoned (3+). The Spore is then removed</description>
        </rule>
        <rule name="Note" id="3942-e943-4e7f-4d2b" hidden="false">
          <description>Huge floating mines spawned in the guts of bio-titans, which drift toward the enemy and burst in clouds of acid and toxic shrapnel.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Deep Strike" id="927f-5ee3-9881-58dc" hidden="false" targetId="f1e1-986f-c783-ca9e" type="rule" />
        <infoLink name="Fearless" id="4ed0-a4b2-93ea-a51c" hidden="false" targetId="b48c-d7e1-2a83-2f5b" type="rule" />
