<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="3478-feaf-71ac-bc80" name="Homebrew - Tyranids" revision="1" battleScribeVersion="2.03" library="false" gameSystemId="28d4-bd2e-4858-ece6" gameSystemRevision="129" type="catalogue" authorName="Isaac">
  <publications>
    <publication id="7478-cf16-4f88-170b" name="Tyranids for The Horus Heresy 2.0 — Homebrew Conversion" shortName="HB - Tyranids" />
  </publications>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Tyranids" hidden="false" id="b0ce-f3f1-c16f-86d1" publicationId="7478-cf16-4f88-170b">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="a202-4a14-88e2-76cb" percentValue="false" includeChildSelections="true" includeChildForces="false" />
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="9414-c38f-8627-deb2" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Swarm Response" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="1d31-ab07-9c64-1fec">
          <characteristics>
            <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Tyranid unit. Another friendly Tyranid Infantry unit (including Monstrous units) within 6" of the target, and within 12" of a friendly Synapse creature, may immediately move up to D6 plus its Initiative Characteristic in inches toward the charging unit. If it ends engaged with the charging unit, it joins the combat and fights in it as though it had been charged†. The reaction may not be used by a unit that is Pinned, Falling Back, embarked, or already locked in combat.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="e90d-e5a8-f42d-da84" id="9365-250f-ff89-1c25" primary="true" name="Allegiance:" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Hive Fleet" hidden="false" id="4dd9-47e3-8469-23c8">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="b32f-1480-877d-95a8" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5997-8e1e-9e1e-3fd9" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Hive Fleet Behemoth" hidden="false" id="80f9-0e6a-e0a1-6cd6" publicationId="7478-cf16-4f88-170b">
              <profiles>
                <profile name="Bow Wave" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="9f43-4917-5513-7e4f">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Behemoth unit. Instead of firing Overwatch, the unit gains Counter-Charge (1) until the end of the phase†. The charging unit keeps its bonuses for charging.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Hyper-aggression" id="562b-f216-ac22-8e77" hidden="false">
                  <description>add 1 to charge distance rolls.</description>
                </rule>
                <rule name="Overwhelming Assault" id="2868-feb1-d4a8-ee61" hidden="false">
                  <description>Infantry units of 20 or more models gain Furious Charge (1), or increase an existing Furious Charge (X) by 1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hive Fleet Hydra" hidden="false" id="94e4-6938-4973-d62d" publicationId="7478-cf16-4f88-170b">
              <profiles>
                <profile name="Swarming Tide" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="a1ca-2bb6-7049-0313">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Hydra Infantry unit of 10 or more models. The Hydra unit moves up to D6 plus its Initiative Characteristic in inches toward the triggering unit, and must end closer to it.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Endless Spawning" id="56dc-dcfd-0096-56bd" hidden="false">
                  <description>Termagant and Hormagaunt units destroyed during the game may be placed into Reserves once each, at their starting strength; they arrive from your table edge†.</description>
                </rule>
                <rule name="Swarming Masses" id="a35d-e3fd-23bd-402b" hidden="false">
                  <description>in close combat, a unit that has more models than the enemy unit it is fighting may re-roll to-hit rolls of 1.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hive Fleet Jormungandr" hidden="false" id="af3f-8679-cae4-9fc7" publicationId="7478-cf16-4f88-170b">
              <profiles>
                <profile name="Burrow" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="dc83-6b37-d8f5-4f53">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Jormungandr Infantry unit. The Jormungandr unit gains Shrouded (5+) until the start of its controlling player's next turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Deep Burrowers" id="2c6e-0975-b036-4dd6" hidden="false">
                  <description>Infantry units of 20 or fewer models gain the Deep Strike special rule.</description>
                </rule>
                <rule name="Tunnel Networks" id="0b85-ce20-38a7-0217" hidden="false">
                  <description>Infantry units that did not Advance in their last turn count as being in cover, with a 6+ cover save, if they are not already†.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hive Fleet Kraken" hidden="false" id="27c5-d821-88be-498d" publicationId="7478-cf16-4f88-170b">
              <profiles>
                <profile name="Lightning Reflexes" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="a319-0d43-8687-471c">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Kraken unit is selected as the target of a Shooting Attack. Before the attack is resolved, the unit moves up to D6 plus its Initiative Characteristic in inches. If it is then out of range or line of sight, the attack is lost.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Ambush Predators" id="becc-fbf4-eac8-3050" hidden="false">
                  <description>Infantry units of 20 or fewer models gain the Outflank special rule†.</description>
                </rule>
                <rule name="Questing Tendrils" id="cb3e-24e6-926a-e044" hidden="false">
                  <description>the unit gains Fleet (1).</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hive Fleet Kronos" hidden="false" id="846c-21b6-826f-827e" publicationId="7478-cf16-4f88-170b">
              <profiles>
                <profile name="Bio-retaliation" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="10e6-de65-d392-3b43">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Kronos unit is selected as the target of a Shooting Attack. The Kronos unit makes a Shooting Attack against the attacking unit before that attack is resolved. Casualties it causes are removed before the enemy attack is resolved and cannot fire back.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Bio-barrage" id="8e63-8b6f-62fd-4fd4" hidden="false">
                  <description>the unit may re-roll to-hit rolls of 1 with ranged weapons.</description>
                </rule>
                <rule name="Deepening Shadow" id="c002-a8c3-76d2-6e1f" hidden="false">
                  <description>the range of Shadow in the Warp for Kronos models is 18" instead of 12".</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hive Fleet Leviathan" hidden="false" id="7885-a4bb-490d-8a74" publicationId="7478-cf16-4f88-170b">
              <profiles>
                <profile name="Synaptic Shielding" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="5862-112f-6950-9865">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Leviathan Synapse creature is selected as the target of a Shooting Attack while within 6" of a friendly Tyranid Infantry unit. Against that attack, the Synapse creature gains Shrouded (5+).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Synaptic Web" id="a39f-176f-219b-2375" hidden="false">
                  <description>the range of the Synapse Creature rule is increased by 3" for Leviathan Synapse creatures.</description>
                </rule>
                <rule name="Unyielding Will" id="0773-909e-5397-9677" hidden="false">
                  <description>units within range of a Leviathan Synapse creature have Feel No Pain (6+) against Shooting Attacks, or improve an existing Feel No Pain by 1 against Shooting Attacks.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Rite of War" hidden="false" id="c5dc-3d0c-5c97-3cae">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6596-e32d-70a9-f80a" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Endless Swarm" hidden="false" id="d11c-e765-976f-3eb9" publicationId="7478-cf16-4f88-170b">
              <rules>
                <rule name="Effects" id="aba8-de06-299d-1e2e" hidden="false">
                  <description>Termagant and Hormagaunt units in a Detachment using this Rite of War may contain up to 40 models, and gain the Line Sub-type.</description>
                </rule>
                <rule name="Limitations" id="0e30-38de-c2f4-0189" hidden="false">
                  <description>A Detachment using this Rite of War must have a Hive Tyrant or Tervigon as its Warlord. A Detachment using this Rite of War may not include any Lords of War, and may include no more than two Heavy Support choices. This Rite of War may not be used by an Allied Detachment.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="8eb9-504b-8404-c63e" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Hidden Brood" hidden="false" id="e176-fe9a-fbf4-cea3" publicationId="7478-cf16-4f88-170b">
              <rules>
                <rule name="Effects" id="f9d1-d28f-a6e2-d470" hidden="false">
                  <description>Genestealer units in a Detachment using this Rite of War gain the Line Sub-type and may contain up to 20 models. Genestealer units and Broodlords in a Detachment using this Rite of War gain the Infiltrate and Move Through Cover special rules. A Genestealer unit in a Detachment using this Rite of War that deployed using the Infiltrate special rule may not be targeted by Shooting Attacks during the first game turn.</description>
                </rule>
                <rule name="Limitations" id="5b80-f753-7414-454b" hidden="false">
                  <description>A Detachment using this Rite of War must have a Broodlord as its Warlord. A Detachment using this Rite of War must include at least two Genestealer units. A Detachment using this Rite of War may not include any Lords of War, and may not include more Monstrous units than Genestealer units. This Rite of War may not be used by an Allied Detachment.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="c0f8-d845-9b63-ff75" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Monstrous Host" hidden="false" id="f063-ad40-a214-7cfd" publicationId="7478-cf16-4f88-170b">
              <rules>
                <rule name="Effects" id="7f94-5530-96d4-9779" hidden="false">
                  <description>Carnifexes may be taken as Troops choices in a Detachment using this Rite of War and gain the Line Sub-type.</description>
                </rule>
                <rule name="Limitations" id="4fc6-f5a5-d20b-a6c8" hidden="false">
                  <description>A Detachment using this Rite of War must have a Hive Tyrant or The Swarmlord as its Warlord. A Detachment using this Rite of War may not include more non-Monstrous Infantry units than Monstrous units. This Rite of War may not be used by an Allied Detachment.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="3296-0218-f55d-07e5" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Skytyrant Swarm" hidden="false" id="6ff5-4104-b1c7-3f45" publicationId="7478-cf16-4f88-170b">
              <rules>
                <rule name="Effects" id="b855-f4b4-b6f9-200b" hidden="false">
                  <description>Gargoyles and Tyranid Shrikes may be taken as Troops choices in a Detachment using this Rite of War and gain the Line Sub-type.</description>
                </rule>
                <rule name="Limitations" id="3be0-b818-a304-3123" hidden="false">
                  <description>A Detachment using this Rite of War must have a Hive Tyrant with wings as its Warlord. Every Infantry unit in a Detachment using this Rite of War must have wings or the Deep Strike special rule, or start the game embarked. This Rite of War may not be used by an Allied Detachment.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="8f36-93d4-a9a3-95a0" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Subterranean Assault" hidden="false" id="da74-5e15-7081-6b5f" publicationId="7478-cf16-4f88-170b">
              <rules>
                <rule name="Effects" id="7eb3-04ad-b405-ef97" hidden="false">
                  <description>Trygons, Mawlocs, Raveners and units with Hive Fleet (Jormungandr) in a Detachment using this Rite of War that Deep Strike may arrive from the first game turn. These units do not scatter if they arrive within 12" of a friendly Trygon or Mawloc.</description>
                </rule>
                <rule name="Limitations" id="115f-e86f-6b0e-d526" hidden="false">
                  <description>A Detachment using this Rite of War must have a Trygon Prime or Tyranid Prime as its Warlord. A Detachment using this Rite of War may not include any Flyers, and may include no more than one Lord of War. This Rite of War may not be used by an Allied Detachment.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="dbb7-019a-91f4-84ba" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Warlord Trait" hidden="false" id="8c43-f436-3af1-8ac4">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e94d-10f2-2507-44fe" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Adaptive Biology" hidden="false" id="a947-aacb-6f49-fbd5" publicationId="7478-cf16-4f88-170b">
              <profiles>
                <profile name="Adaptive Biology" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="2549-6914-f9e8-a6cf">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord gains Feel No Pain (5+), or improves an existing Feel No Pain by 1. In addition, once per game, a friendly Tyranid unit within 12" of the Warlord may make the Swarm Response reaction without spending a point of the Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="3ad3-65bc-ead9-ab61" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Alpha Leader" hidden="false" id="0af3-9968-fdd5-371a" publicationId="7478-cf16-4f88-170b">
              <profiles>
                <profile name="Alpha Leader" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="c68f-3da7-f157-3ef4">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Friendly Tyranid units within 12" of the Warlord may re-roll failed charge distances. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Assault phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="b4b9-484a-d21f-ba7b" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Synaptic Lynchpin" hidden="false" id="db49-3a7a-de5a-6e4b" publicationId="7478-cf16-4f88-170b">
              <profiles>
                <profile name="Synaptic Lynchpin" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="9f72-e302-0750-996f">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The range of the Warlord's Synapse Creature rule is increased by 3". In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Movement phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="2b7e-c928-8b5f-4611" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Monstrous Hunger" hidden="true" id="9b3c-804f-14e6-6477" publicationId="7478-cf16-4f88-170b">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="80f9-0e6a-e0a1-6cd6" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Monstrous Hunger" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="2d80-9e67-3af7-f764">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord and any unit it joins gain Rage (2).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="2e73-e3ee-34d0-4dd1" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Brood Mother" hidden="true" id="7969-2761-9556-fc1b" publicationId="7478-cf16-4f88-170b">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="94e4-6938-4973-d62d" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Brood Mother" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="cc99-7159-efa4-5355">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Once per game, at the start of your turn, the Warlord may return D6 slain models to one friendly Termagant or Hormagaunt unit within 12".</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="744e-3a97-db96-5627" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Subterranean Hunter" hidden="true" id="9963-2c1c-f6a5-1f0e" publicationId="7478-cf16-4f88-170b">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="af3f-8679-cae4-9fc7" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Subterranean Hunter" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="399d-a85b-c187-55de">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord and any unit it joins gain the Deep Strike special rule, and may re-roll the Reserves roll to arrive.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="8487-7d2f-f5ca-0d85" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
