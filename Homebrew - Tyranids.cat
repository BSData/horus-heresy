    <selectionEntry type="unit" import="true" name="Mycetic Spore" hidden="false" id="d9ef-03cf-c92b-5b7d" publicationId="7478-cf16-4f88-170b">
      <rules>
        <rule name="Living Drop Pod" id="61ad-16d3-2466-1ac0" hidden="false">
          <description>The Mycetic Spore must start the game in Reserves and arrive by Deep Strike, on the first game turn if you wish. It may not move or charge after arriving. Its passengers must disembark the turn it lands</description>
        </rule>
        <rule name="Transport" id="35e5-ef3c-9eda-baa6" hidden="false">
          <description>Transport Capacity 20 Tyranid Infantry models, or one Monstrous model that is not Gargantuan. Passengers may disembark from any point of the spore.</description>
        </rule>
        <rule name="Note" id="2d32-0e00-fbbd-2c88" hidden="false">
          <description>This model may only be selected as a Dedicated Transport for another unit, and may not be selected as a separate unit.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Deep Strike" id="fbf6-ad2e-c01c-8b26" hidden="false" targetId="f1e1-986f-c783-ca9e" type="rule" />
