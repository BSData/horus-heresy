    <selectionEntry type="unit" import="true" name="Canoptek Spyders" hidden="false" id="b7d1-81db-b8e2-ae35" publicationId="6dbb-42c9-758d-cd66">
      <rules>
        <rule name="Scarab Hive" id="305d-0a44-9819-56ae" hidden="false">
          <description>At the start of each of your turns, the Spyder may add one Canoptek Scarab Swarm to a friendly Scarab unit within 6", up to its starting size</description>
