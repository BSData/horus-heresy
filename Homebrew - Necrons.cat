      <rules>
        <rule name="Eternity Gate" id="adf9-e95b-474b-c640" hidden="false">
          <description>Once per turn, one friendly Necron Infantry unit in Reserves may arrive within 6" of the Monolith, placed as though by Deep Strike without scattering</description>
        </rule>
        <rule name="Unstoppable Monolith" id="25f1-dab9-f27b-b063" hidden="false">
