    <selectionEntry type="unit" import="true" name="Ghost Ark" hidden="false" id="8297-0ba9-d8a4-ea5e" publicationId="6dbb-42c9-758d-cd66">
      <rules>
        <rule name="Quantum Shielding" id="9f0e-cca8-9aed-45c3" hidden="false">
          <description>Until the Ghost Ark suffers its first penetrating hit, its Front and Side Armour are 13</description>
        </rule>
        <rule name="Repair Barge" id="fb4c-5b4a-fe6c-5e08" hidden="false">
          <description>At the end of each of your turns, one friendly unit of Necron Warriors embarked on it, or within 6", returns up to D3 slain models to play, in coherency</description>
        </rule>
        <rule name="Note" id="d093-270e-41d9-ca8c" hidden="false">
          <description>This model may be selected as a Dedicated Transport for Necron Warriors, or as a Heavy Support choice. It may only carry Necron Warriors and Necron characters.</description>
        </rule>
      </rules>
