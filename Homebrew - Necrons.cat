    <selectionEntry type="unit" import="true" name="Cryptothralls" hidden="false" id="1360-9cdf-6762-f2db" publicationId="6dbb-42c9-758d-cd66">
      <rules>
        <rule name="Protector Construct" id="f4a7-eea0-609b-5c28" hidden="false">
          <description>A Cryptek who joins the unit may allocate wounds to the Cryptothralls as Look Out, Sir! on a 2+</description>
