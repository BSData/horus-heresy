    <selectionEntry type="unit" import="true" name="Nemesor Zahndrekh" hidden="false" id="4d09-6c0f-120e-094e" publicationId="6dbb-42c9-758d-cd66">
      <rules>
        <rule name="Adaptive Tactics" id="ef17-373c-863e-8f65" hidden="false">
          <description>At the start of each of your turns, choose one friendly unit within 12"; until your next turn it gains Counter-Attack (1), Hatred (Everything), Preferred Enemy (Everything) or Stubborn</description>
        </rule>
        <rule name="Counter-tactics" id="575f-8839-1c60-1211" hidden="false">
          <description>Once per game, cancel one enemy special rule on one enemy unit within 12" until the end of the turn</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="1827-7052-e80d-6e0b" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
