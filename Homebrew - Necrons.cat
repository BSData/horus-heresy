      <rules>
        <rule name="Ancient Collector" id="5aee-fccc-5d76-b5f8" hidden="false">
          <description>Trazyn may re-roll failed to-hit rolls against Unique characters</description>
        </rule>
        <rule name="Surrogate Hosts" id="927a-323a-bb8d-f304" hidden="false">
          <description>When Trazyn is slain, roll a D6; on a 2+, remove one friendly Necron Lord or Cryptek model instead (not a Unique character), and place Trazyn in its place with his full Wounds</description>
