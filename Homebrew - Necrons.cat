    <selectionEntry type="unit" import="true" name="Tesseract Vault" hidden="false" id="4cf4-5e34-5e19-bda5" publicationId="6dbb-42c9-758d-cd66">
      <rules>
        <rule name="Imprisoned C'tan" id="bd5b-aff8-7069-2bb2" hidden="false">
          <description>The Tesseract Vault knows three Powers of the C'tan of your choice, chosen before the game, and may use two of them each Shooting phase in addition to firing its tesla spheres</description>
        </rule>
        <rule name="Vengeance of the Enchained" id="17de-5b39-e9ff-ab5f" hidden="false">
          <description>Each time the Vault loses a Hull Point, roll a D6; on a 6, every unit within D6" suffers a hit at Strength 6, AP 4</description>
        </rule>
      </rules>
