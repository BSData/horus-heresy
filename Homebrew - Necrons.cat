    <selectionEntry type="unit" import="true" name="Szarekh, the Silent King" hidden="false" id="59c6-515d-6fee-2e37" publicationId="6dbb-42c9-758d-cd66">
      <rules>
        <rule name="Menhir Defence" id="9ad9-9aaa-f566-d0df" hidden="false">
          <description>While a Menhir lives, wounds allocated to Szarekh may be allocated to a Menhir instead, as Look Out, Sir! on a 2+</description>
        </rule>
        <rule name="The Silent King" id="ed07-9315-5a5c-3e92" hidden="false">
          <description>If he is in your army, Szarekh must be your Warlord. Every friendly Necron unit improves its Reanimation Protocols by 1 while within 12" of him</description>
        </rule>
        <rule name="Triarchal Command" id="79e7-b857-73f9-48ac" hidden="false">
          <description>Once per turn, one friendly Necron unit within 12" may make an additional reaction without spending from your Reaction Allotment</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="8ca0-982f-8f28-9301" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
