    <selectionEntry type="unit" import="true" name="Imotekh the Stormlord" hidden="false" id="9220-96c3-6f1a-09e2" publicationId="6dbb-42c9-758d-cd66">
      <rules>
        <rule name="Hyperlogical Strategist" id="f486-286f-8b2a-0708" hidden="false">
          <description>Add 1 to your Reserves rolls, and you may re-roll the roll to seize the initiative</description>
        </rule>
        <rule name="Lord of the Storm" id="6b19-acf6-7177-aa0d" hidden="false">
          <description>From the second game turn, at the start of each of your turns, D3 enemy units within 36" each suffer D3 hits at Strength 8, AP 5</description>
        </rule>
        <rule name="Phaeron" id="921f-e3db-da2c-b7c2" hidden="false">
          <description>If he is in your army, Imotekh must be your Warlord</description>
        </rule>
      </rules>
