      <rules>
        <rule name="Gravitic Pulse" id="cc8d-47ee-75f7-bfa5" hidden="false">
          <description>At the start of each of your Shooting phases, every enemy Flyer and unit with jump packs or jet packs within 18" suffers D3 hits at Strength 7, AP 4</description>
        </rule>
        <rule name="Tesla Sphere Array" id="ef57-61ab-860a-cd93" hidden="false">
          <description>The Obelisk may fire all four tesla spheres at different targets</description>
