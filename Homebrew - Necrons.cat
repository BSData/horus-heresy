<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="f234-916c-45d4-02ac" name="Homebrew - Necrons" revision="1" battleScribeVersion="2.03" library="false" gameSystemId="28d4-bd2e-4858-ece6" gameSystemRevision="130" type="catalogue" authorName="Isaac">
  <publications>
    <publication id="6dbb-42c9-758d-cd66" name="Necrons for The Horus Heresy 2.0 — Homebrew Conversion" shortName="HB - Necrons" />
  </publications>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Necrons" hidden="false" id="a4f8-8f7b-bae8-719e" publicationId="6dbb-42c9-758d-cd66">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="d36a-3a95-54a4-b33a" percentValue="false" includeChildSelections="true" includeChildForces="false" />
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="53c9-d7d0-f7c1-7ada" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Reanimating Phalanx" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="fa61-92dd-1262-25a4">
          <characteristics>
            <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Necron Infantry unit is selected as the target of a Shooting Attack. Against that attack, the unit improves its Reanimation Protocols by 1, to a best of 4+, and after the attack is resolved it may make a Return Fire Shooting Attack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="e90d-e5a8-f42d-da84" id="0d29-0068-f527-6b8b" primary="true" name="Allegiance:" />
        <categoryLink targetId="3c8e-5a1d-9b47-e2f0" id="5c41-8a2d-51c0-72bf" primary="false" name="Xenos Army" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Dynasty" hidden="false" id="87b7-33db-ce72-dd83">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="97b2-d829-a026-d27f" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4d76-b850-5478-df5a" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Mephrit" hidden="false" id="dd17-f1a7-2884-2839" publicationId="6dbb-42c9-758d-cd66">
              <profiles>
                <profile name="Solar Flare" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="c8b2-892d-6a4f-e05d">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Mephrit unit. The unit fires Overwatch with all ranged weapons, adding 1 to its Ballistic Skill.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Burning Hatred" id="244f-a7f0-af91-e38c" hidden="false">
                  <description>the unit has Hatred (Everything).</description>
                </rule>
                <rule name="Solar Fury" id="d506-bdbc-43a6-fdb1" hidden="false">
                  <description>against targets within half range, the unit's ranged weapons improve their AP by 1, to a best of AP 2.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Nephrekh" hidden="false" id="9e72-9525-6bf6-6c2c" publicationId="6dbb-42c9-758d-cd66">
              <profiles>
                <profile name="Phase Shift" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="cc29-780f-043f-13b7">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Nephrekh unit. The unit moves up to 6" in any direction, ignoring terrain and models.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Gilded Bodies" id="4a39-d4e0-d40f-2e75" hidden="false">
                  <description>the unit has a 6+ Invulnerable Save, or improves an existing one by 1, to a best of 4+.</description>
                </rule>
                <rule name="Translocation Beams" id="e1d0-d273-4cd9-9cba" hidden="false">
                  <description>the unit ignores terrain while moving.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Nihilakh" hidden="false" id="850f-f751-0ded-a0aa" publicationId="6dbb-42c9-758d-cd66">
              <profiles>
                <profile name="Defend the Hoard" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="fdf5-d688-950c-6aca">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Nihilakh unit. The unit fires Overwatch with every model, and the charger subtracts 2 from its charge distance.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Aggressively Territorial" id="fd44-0db1-0646-b66e" hidden="false">
                  <description>in a turn in which it did not move, the unit may re-roll to-hit rolls of 1.</description>
                </rule>
                <rule name="Hold What Is Ours" id="0e22-e790-1279-38e5" hidden="false">
                  <description>the unit improves its Reanimation Protocols by 1, to a best of 4+, while holding an objective.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Novokh" hidden="false" id="5b43-3943-28f9-ac17" publicationId="6dbb-42c9-758d-cd66">
              <profiles>
                <profile name="Crimson Haze" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="6dcc-e7b1-fb05-9e9f">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Novokh unit. Instead of firing Overwatch, the unit gains Counter-Charge (1) until the end of the phase†.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Awakened by Murder" id="2f93-6096-27d3-bd38" hidden="false">
                  <description>the unit adds 1 to its Attacks in a turn in which it charged.</description>
                </rule>
                <rule name="Blood-fury" id="53aa-26cc-7b07-5ba1" hidden="false">
                  <description>the unit may re-roll to-hit rolls of 1 in close combat.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Sautekh" hidden="false" id="995c-8b5e-98a3-cbef" publicationId="6dbb-42c9-758d-cd66">
              <profiles>
                <profile name="Unbroken Line" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="c594-cf6a-e3cb-d1bc">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Sautekh unit is selected as the target of a Shooting Attack. The unit makes a Return Fire Shooting Attack before the enemy attack is resolved.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Relentless Advance" id="2bea-f8ff-abfe-87e7" hidden="false">
                  <description>the unit may move and fire Heavy weapons as though it had not moved.</description>
                </rule>
                <rule name="Stormlord's Command" id="88d8-b216-32d6-9dab" hidden="false">
                  <description>the unit may re-roll failed Morale checks.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Szarekhan" hidden="false" id="c22e-2727-00fa-9804" publicationId="6dbb-42c9-758d-cd66">
              <profiles>
                <profile name="Dimensional Shift" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="1dbe-6908-b9e1-5f6d">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Szarekhan unit is selected as the target of a Shooting Attack. Against that attack, the unit gains Shrouded (5+).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Aegis of the Silent King" id="1dd3-8bdd-8211-d5d3" hidden="false">
                  <description>enemy psykers within 12" subtract 1 from their Leadership for Psychic checks.</description>
                </rule>
                <rule name="Undying Warriors" id="8702-39b8-427b-ac7f" hidden="false">
                  <description>the unit has Reanimation Protocols (4+) instead of (5+).</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Rite of War" hidden="false" id="3a1b-ed49-9b43-f64b">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7893-b323-1e43-00a4" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Canoptek Harvest" hidden="false" id="6b09-f140-c83a-fae8" publicationId="6dbb-42c9-758d-cd66">
              <rules>
                <rule name="Effects" id="3b7a-78e9-8742-b965" hidden="false">
                  <description>Canoptek Wraiths and Canoptek Scarabs may be taken as Troops and gain the Line sub-type.</description>
                </rule>
                <rule name="Limitations" id="5b71-0242-e110-cda0" hidden="false">
                  <description>Requires a Cryptek, Technomancer or Plasmancer as Warlord.   no Lords of War, and Infantry other than Canoptek units must not outnumber Canoptek units.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="de9b-ce24-6967-fc69" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Destroyer Cult" hidden="false" id="0247-ddd5-9aca-d110" publicationId="6dbb-42c9-758d-cd66">
              <rules>
                <rule name="Effects" id="f3c1-f32f-255d-2ca9" hidden="false">
                  <description>Destroyers, Heavy Destroyers, Skorpekh and Ophydian Destroyers gain Rage (2), and Destroyers may be taken as Troops.</description>
                </rule>
                <rule name="Limitations" id="c0cb-3e5b-4cc9-6e43" hidden="false">
                  <description>Requires a Destroyer Lord or Skorpekh Lord as Warlord.   no Necron Warriors, and no Ghost Arks.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="df91-c294-5ca7-d49d" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Royal Court" hidden="false" id="5db8-02f9-37ab-45dc" publicationId="6dbb-42c9-758d-cd66">
              <rules>
                <rule name="Effects" id="8a0d-5d73-e222-7af8" hidden="false">
                  <description>Lychguard may be taken as Troops and gain the Line sub-type, and the Overlord may take a Royal Warden and up to two Crypteks without using HQ slots.</description>
                </rule>
                <rule name="Limitations" id="fa66-428c-2e11-257f" hidden="false">
                  <description>Requires an Overlord as Warlord.   no Destroyers of any kind.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="69aa-3e15-36e7-d255" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tomb World Awakening" hidden="false" id="4abe-57cb-99ed-e198" publicationId="6dbb-42c9-758d-cd66">
              <rules>
                <rule name="Effects" id="ed2a-0157-57e6-7b2c" hidden="false">
                  <description>every unit improves its Reanimation Protocols by 1, to a best of 4+, in the first two game turns.</description>
                </rule>
                <rule name="Limitations" id="c609-53e2-1d82-13ea" hidden="false">
                  <description>Requires any Necron HQ as Warlord.   no Fast Attack choices, and every unit must deploy on the battlefield (no Reserves).</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="7fe4-a290-73ca-e5a1" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Warlord Trait" hidden="false" id="0beb-64c2-9792-abf1">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="1ec1-7ce3-7a30-36de" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Enduring Will" hidden="false" id="8eae-bbe1-5a80-de16" publicationId="6dbb-42c9-758d-cd66">
              <profiles>
                <profile name="Enduring Will" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="eafd-6af7-3366-be88">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord has Reanimation Protocols (4+), or improves an existing one by 1, to a best of 3+. In addition, your army may make one additional reaction in your opponent's Assault phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="0fbe-80ea-2ce4-d1c9" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Eternal Madness" hidden="false" id="e2fc-52a7-8900-0ea3" publicationId="6dbb-42c9-758d-cd66">
              <profiles>
                <profile name="Eternal Madness" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="e88c-ab5a-996c-ed9a">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord and any unit he joins gain Rage (2). In addition, your army may make one additional reaction in your opponent's Movement phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="973b-3dbe-175a-84db" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Phaeron of the Stars" hidden="false" id="cb32-5315-7946-11ef" publicationId="6dbb-42c9-758d-cd66">
              <profiles>
                <profile name="Phaeron of the Stars" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="f595-5c46-d7d6-91f3">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">You may re-roll one Reserves roll each turn. In addition, your army may make one additional reaction in your opponent's Shooting phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="402e-8b5d-cf48-67e1" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Merciless Tyrant" hidden="true" id="e90a-8268-d5d2-c120" publicationId="6dbb-42c9-758d-cd66">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="dd17-f1a7-2884-2839" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Merciless Tyrant" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="7c38-7d14-4f59-df6c">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord's ranged weapons gain Shred.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="c9de-161c-b3b8-0a90" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Skin of Living Gold" hidden="true" id="6df3-b566-4f34-d669" publicationId="6dbb-42c9-758d-cd66">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="9e72-9525-6bf6-6c2c" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Skin of Living Gold" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="6db2-5a38-f3ad-cd4c">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord has Feel No Pain (5+).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="34b2-276f-9675-c58d" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Precognitive Strike" hidden="true" id="875e-cd13-7422-c978" publicationId="6dbb-42c9-758d-cd66">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="850f-f751-0ded-a0aa" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Precognitive Strike" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="05a0-73c9-34fc-0b85">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord strikes first in close combat, regardless of Initiative.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="d02a-3d25-4042-5537" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Honourable Combatant" hidden="true" id="ec77-ee45-182b-34fa" publicationId="6dbb-42c9-758d-cd66">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="5b43-3943-28f9-ac17" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Honourable Combatant" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="fbfa-a23f-1e08-72f6">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord's melee weapons gain Rending (6+).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="a044-2dcb-f211-d769" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Implacable Conqueror" hidden="true" id="4d88-5f05-2a70-497a" publicationId="6dbb-42c9-758d-cd66">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="995c-8b5e-98a3-cbef" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Implacable Conqueror" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="6b3b-42a2-9b1f-f20c">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Friendly Sautekh units within 12" of the Warlord may re-roll to-hit rolls of 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="d400-8add-f394-32a3" primary="true" name="Warlord Traits:" />
