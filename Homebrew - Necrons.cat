    <selectionEntry type="unit" import="true" name="C'tan Shard of the Deceiver" hidden="false" id="93f7-975f-be09-1788" publicationId="6dbb-42c9-758d-cd66">
      <rules>
        <rule name="Dread" id="588a-053a-b5cf-fe5c" hidden="false">
          <description>Enemy units within 12" subtract 1 from their Leadership and may not re-roll Morale checks</description>
        </rule>
        <rule name="Grand Illusion" id="9925-5a28-79f5-4730" hidden="false">
          <description>After deployment, redeploy up to D3 friendly units, which may be placed anywhere in your deployment zone or into Reserves</description>
        </rule>
        <rule name="Powers of the C'tan" id="898a-365c-ac25-d432" hidden="false">
          <description>Knows Cosmic Fire and Transdimensional Thunderbolt</description>
        </rule>
        <rule name="Reality Unravels" id="9cf6-0f63-181a-9f00" hidden="false">
          <description>when the Shard is slain, every unit within D6" suffers D6 hits at Strength 6, AP 4</description>
