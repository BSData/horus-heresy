          <description>Friendly Necron vehicles within 12" may re-roll failed Living Metal rolls; enemy vehicles within 12" subtract 1 from their Ballistic Skill</description>
        </rule>
        <rule name="Powers of the C'tan" id="4c94-49c7-3d0b-af80" hidden="false">
          <description>Knows Sky of Falling Stars and Transdimensional Thunderbolt</description>
        </rule>
        <rule name="Reality Unravels" id="60f6-bf86-48a5-4395" hidden="false">
          <description>when the Shard is slain, every unit within D6" suffers D6 hits at Strength 6, AP 4</description>
        </rule>
        <rule name="Voltaic Storm" id="66d6-ee6e-7287-7b7c" hidden="false">
          <description>Once per Shooting phase, one enemy vehicle within 18" suffers D3 hits at Strength 9, AP 2, with Haywire</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="fa5b-e133-c097-764c" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
