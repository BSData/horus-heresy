    <selectionEntry type="unit" import="true" name="Hexmark Destroyer" hidden="false" id="fb79-76d2-8c20-05b5" publicationId="6dbb-42c9-758d-cd66">
      <rules>
        <rule name="Inescapable Death" id="7d34-11bd-7492-8e20" hidden="false">
          <description>When an enemy unit ends a move within 6", the Hexmark may make a Shooting Attack against it, as a free reaction once per turn</description>
