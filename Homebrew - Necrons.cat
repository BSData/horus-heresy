          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The bearer improves its Reanimation Protocols by 1 for itself only.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Resurrection Orb" hidden="false" id="cc13-8fa1-31cd-3b63" publicationId="6dbb-42c9-758d-cd66">
