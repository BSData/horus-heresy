          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">The bearer and the unit it joins have Deep Strike. Once per game, at the start of your Movement phase, the unit may be removed and placed anywhere on the battlefield, as though arriving by Deep Strike.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
