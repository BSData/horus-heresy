  <sharedRules>
    <rule name="Ever-living" id="ad3d-babd-4538-d27f" hidden="false" publicationId="6dbb-42c9-758d-cd66">
      <description>A character with this rule may use Reanimation Protocols even if every other model in its unit has been destroyed.</description>
    </rule>
    <rule name="Gauss" id="045c-3598-ac94-3ef3" hidden="false" publicationId="6dbb-42c9-758d-cd66">
      <description>A weapon with the Gauss trait has Breaching (6+), and each armour penetration roll of 6 it makes always causes at least a glancing hit, regardless of the target's Armour Value†.</description>
    </rule>
    <rule name="Living Metal" id="be44-ba3a-df9c-4284" hidden="false" publicationId="6dbb-42c9-758d-cd66">
      <description>A vehicle with this rule ignores Crew Shaken results on the Vehicle Damage table, and at the end of each of your turns, rolls a D6; on a 6, it restores one lost Hull Point†.</description>
    </rule>
    <rule name="Reanimation Protocols (X)" id="02d0-b2f6-035f-b837" hidden="false" publicationId="6dbb-42c9-758d-cd66">
      <description>Each time a model with this rule would lose its last Wound, roll a D6; on a roll of X or more, it is not removed and stays in play with 1 Wound. Reanimation Protocols is not Feel No Pain: rules that ignore or negate Feel No Pain do not affect it. It is a Damage Mitigation roll: a model may make only a single Damage Mitigation roll of any type (including Feel No Pain) for any given Wound. It cannot be used against Instant Death or Destroyer attacks.</description>
    </rule>
    <rule name="Tesla" id="db2a-0b47-9acc-50a9" hidden="false" publicationId="6dbb-42c9-758d-cd66">
      <description>Each to-hit roll of 6 made with a weapon with the Tesla trait inflicts two additional hits on the target.</description>
    </rule>
    <rule name="Unstoppable" id="fee5-2fcd-f837-8996" hidden="false" publicationId="6dbb-42c9-758d-cd66">
      <description>Necron units never become Pinned, but may not Advance.</description>
    </rule>
    <rule name="Dynasty (X)" id="92dd-e265-ca98-0c15" hidden="false" publicationId="6dbb-42c9-758d-cd66">
      <description>When building an army, choose one Dynasty for each detachment. Every unit in that detachment gains Dynasty (X). Imotekh, Zahndrekh and Obyron may only join a Sautekh detachment; Trazyn and Szeras may join any Dynasty; Orikan only Sautekh; Anrakyr any Dynasty. Each Dynasty's Advanced Reaction is available in addition to Reanimating Phalanx and costs one point of the Reaction Allotment†.</description>
    </rule>
    <rule name="Invulnerable Save (X)" id="bf2b-b1a4-ef3b-b16c" hidden="false" publicationId="6dbb-42c9-758d-cd66">
      <description>The model has an Invulnerable Save of X, which may be taken against any Wound instead of its armour save.</description>
    </rule>
    <rule name="Supersonic" id="61f8-0325-467d-7580" hidden="false" publicationId="6dbb-42c9-758d-cd66">
      <description>Listed on this datasheet but not defined in the conversion doc.</description>
    </rule>
  </sharedRules>
</catalogue>
