          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Once per game, at the start of any phase, the bearer's unit may improve its Reanimation Protocols by 2, to a best of 3+, until the end of that phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Sempiternal Weave" hidden="false" id="539d-fdc8-3c9c-1b3d" publicationId="6dbb-42c9-758d-cd66">
