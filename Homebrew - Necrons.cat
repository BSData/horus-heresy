        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Canoptek Cloak" hidden="false" id="d1da-e1d0-14d6-60b2" publicationId="6dbb-42c9-758d-cd66">
