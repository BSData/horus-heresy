      <rules>
        <rule name="Speed Demons" id="d549-17a8-0658-3a1b" hidden="false">
          <description>A model that chooses to Advance gains Shrouded (5+) until the start of the controlling player's next turn</description>
        </rule>
        <rule name="Speed Freek Boss" id="3745-6beb-998b-51c1" hidden="false">
          <description>Friendly Speed Freek buggies and Warbikers within 6" use his Ld 9 and re-roll failed Pinning tests</description>
        </rule>
        <rule name="Independent Character restriction" id="a12c-89d8-c166-8bc0" hidden="false">
          <description>May only join Warbikers</description>
