    <selectionEntry type="unit" import="true" name="Ghazghkull Thraka" hidden="false" id="797f-04dc-77fb-4579" publicationId="96d0-c462-d158-fbad">
      <rules>
        <rule name="Da Grand Warlord's Ladz" id="63b4-b9a3-2ee3-442b" hidden="false">
          <description>While within 3" of a friendly Ork Infantry unit, enemy units more than 12" away may not target him with shooting attacks</description>
        </rule>
        <rule name="Makari, Hoist Dat Banner!" id="df58-ba20-e0e6-f3a3" hidden="false">
          <description>Once per game, in your Movement phase, pick friendly Ork units up to the current game turn number; until the start of your next turn they count as being under a Waaagh!, without using the army's Waaagh!</description>
        </rule>
        <rule name="Makari's Luck" id="b45e-79da-04f5-4174" hidden="false">
          <description>Makari has a 4+ invulnerable save, and while Makari lives, Ghazghkull's It Will Not Die improves by 1, from (5+) to (4+)</description>
        </rule>
        <rule name="Primarch" id="6151-12c0-97f7-e91b" hidden="false">
          <description>Ghazghkull has every rule of the Primarch unit type, including Eternal Warrior, Fearless, It Will Not Die (5+), Bulky (4) and Relentless, and must be your Warlord</description>
        </rule>
        <rule name="Prophet of da Great Waaagh!" id="fb5e-afab-7deb-9185" hidden="false">
          <description>Friendly Ork units within 6" add 1 to their Weapon Skill and re-roll to-wound rolls of 1 in close combat</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="ef27-67d7-ddad-1ae9" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
        <infoLink name="Battle-Hardened (X)" id="72f7-48aa-c976-370d" hidden="false" targetId="5c3b-ed0b-4ad0-d547" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Battle-Hardened (2) (Makari only)" />
          </modifiers>
        </infoLink>
        <infoLink name="'Ere We Go!" id="5e1f-ea1e-14e3-d457" hidden="false" targetId="fe04-50c9-c0ad-8fb5" type="rule" />
        <infoLink name="Grot 'Tendant" id="148c-84ac-3d3b-9ae4" hidden="false" targetId="a26d-6630-480f-550c" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Grot 'Tendant (Makari only)" />
          </modifiers>
        </infoLink>
        <infoLink name="Invulnerable Save (X)" id="123a-ce61-7d56-1f3b" hidden="false" targetId="85f3-c187-c717-378e" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Invulnerable Save (4+)" />
          </modifiers>
        </infoLink>
        <infoLink name="Klan (X)" id="4774-a8f6-a305-ef45" hidden="false" targetId="a734-620c-db79-3594" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="Klan (Goffs)" />
