    <selectionEntry type="unit" import="true" name="Mek Boss Buzzgob" hidden="false" id="13f1-a28a-af4f-0551" publicationId="96d0-c462-d158-fbad">
      <rules>
        <rule name="Mek-Smasha (4+)" id="7099-ca9d-948a-793f" hidden="false">
          <description>Improved to (3+) by Grot Gorgutz</description>
        </rule>
        <rule name="Kustom Repairs" id="a610-90a5-d566-4d89" hidden="false">
          <description>When Buzzgob uses Mek-Smasha, he may restore up to D3 lost Hull Points or Wounds instead of one, and may use it twice each turn on different models</description>
        </rule>
        <rule name="Mekaniak" id="d6a8-4d9f-53c3-2a02" hidden="false">
          <description>Friendly Ork vehicles and Dreadnoughts within 6" of Buzzgob improve their Ramshackle (X) by 1, to a best of Ramshackle (4+)</description>
        </rule>
        <rule name="Smoky Squig" id="942f-98a9-fa95-0c8a" hidden="false">
          <description>Dok Scrabbit's fumes give Buzzgob and any unit he joins Shrouded (6+)</description>
        </rule>
        <rule name="Note" id="86a2-d86a-d1db-1138" hidden="false">
          <description>The most cunning Mek of his Waaagh!, who can keep a battlewagon running with nothing but a big choppa, a grot and a squig.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink name="Xenos" id="7dc2-1411-72e8-e08e" hidden="false" targetId="e6a0-8f13-d5c2-4b79" type="rule" />
