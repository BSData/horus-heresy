          <characteristics>
            <characteristic name="Description" typeId="347e-ee4a-764f-6be3">Once per game, a unit that includes at least one model with an ammo runt may re-roll one failed to-hit roll when shooting. Remove the ammo runt after it is used.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="'Ard Case" hidden="false" id="166b-c0a4-9d59-f7ef" publicationId="96d0-c462-d158-fbad">
