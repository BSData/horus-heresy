      <rules>
        <rule name="Boss's Banner" id="2010-d250-1635-3f2b" hidden="false">
          <description>Does not use an Elites slot if the army includes a Warboss</description>
        </rule>
        <rule name="Hoist Da Banner" id="3afb-6908-1119-d37a" hidden="false">
