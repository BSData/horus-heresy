      <rules>
        <rule name="Dakka Dakka" id="6f0c-c448-7fb9-ef7e" hidden="false">
          <description>After moving no more than 12", the unit may re-roll one failed to-hit roll per model when shooting</description>
        </rule>
        <rule name="Speed Demons" id="1031-2820-3a85-2310" hidden="false">
