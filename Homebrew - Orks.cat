<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="674d-7094-c86d-3ace" name="Homebrew - Orks" revision="1" battleScribeVersion="2.03" library="false" gameSystemId="28d4-bd2e-4858-ece6" gameSystemRevision="130" type="catalogue" authorName="Isaac">
  <publications>
    <publication id="96d0-c462-d158-fbad" name="Orks for The Horus Heresy 2.0 — Homebrew Conversion" shortName="HB - Orks" />
  </publications>
  <selectionEntries>
    <selectionEntry type="upgrade" import="true" name="Orks" hidden="false" id="adbe-53b5-788c-2bbb" publicationId="96d0-c462-d158-fbad">
      <constraints>
        <constraint type="min" value="1" field="selections" scope="force" shared="true" id="9160-2700-3eb2-858b" percentValue="false" includeChildSelections="true" includeChildForces="false" />
        <constraint type="max" value="1" field="selections" scope="force" shared="true" id="582d-26d1-b74f-8b66" percentValue="false" includeChildSelections="true" includeChildForces="false" />
      </constraints>
      <profiles>
        <profile name="Get Stuck In" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="bc37-fd21-3539-03d7">
          <characteristics>
            <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of, and in line of sight to, an Ork Infantry or Cavalry unit. The reacting unit immediately moves up to D6 plus its Initiative Characteristic in inches, directly toward the triggering unit, and must end closer to it than it started. If this move ends with the reacting unit engaged with the triggering unit, the reacting unit counts as having charged it, gaining any bonuses for charging, and the combat is fought in the next Assault phase†. The reaction may not be used by a unit that is Pinned, Falling Back, embarked, or already locked in combat.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="e90d-e5a8-f42d-da84" id="c68a-b5f7-da74-d14a" primary="true" name="Allegiance:" />
        <categoryLink targetId="3c8e-5a1d-9b47-e2f0" id="a5ff-7c5d-b535-fe8e" primary="false" name="Xenos Army" />
      </categoryLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Klan" hidden="false" id="7efd-88fc-f72b-54e4">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6a56-3aa4-97c1-da94" percentValue="false" includeChildSelections="false" includeChildForces="false" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="87b1-868f-143e-fd6f" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Bad Moons" hidden="false" id="76f8-00ce-5d7b-d34a" publicationId="96d0-c462-d158-fbad">
              <profiles>
                <profile name="Shoot 'Em First" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="cc0f-7efe-eba8-eccf">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Bad Moon unit is selected as the target of a Shooting Attack. The Bad Moon unit makes a Shooting Attack against the attacking unit before that attack is resolved. Casualties it causes are removed before the enemy attack is resolved and cannot fire back.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Da Best Gear" id="2f3c-3ada-8a04-c710" hidden="false">
                  <description>the unit may re-roll to-hit rolls of 1 with Assault weapons.</description>
                </rule>
                <rule name="Flashy Kustom Jobs" id="2ebc-8bc0-9c01-80fb" hidden="false">
                  <description>the unit may re-roll Gets Hot rolls of 1.</description>
                </rule>
                <rule name="Teef to Spare" id="6ecc-8969-75a4-7533" hidden="false">
                  <description>each Bad Moon character may take one item from its options worth 15 points or less at no cost.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Blood Axes" hidden="false" id="9641-5c76-afc1-1fa8" publicationId="96d0-c462-d158-fbad">
              <profiles>
                <profile name="Kunnin' Withdrawal" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="4b12-3a19-05ca-c35c">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Movement phase). Trigger: an enemy unit ends a move within 12" of a Blood Axe Infantry unit. The Blood Axe unit moves up to D6 plus its Initiative Characteristic in inches, and must end further from the triggering unit than it started. It then gains Shrouded (6+) until the start of its controlling player's next turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Kunnin' Plans" id="3392-da5d-c75c-9ae4" hidden="false">
                  <description>up to two Infantry units of 15 or fewer models in the detachment that do not already have Infiltrate gain the Infiltrate special rule.</description>
                </rule>
                <rule name="Taktiks" id="0ee2-3c95-7b38-8239" hidden="false">
                  <description>in the first game turn, the unit counts as being in cover if it is not already, giving a 6+ cover save†.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Deathskulls" hidden="false" id="8020-4d05-451b-101e" publicationId="96d0-c462-d158-fbad">
              <profiles>
                <profile name="Lucky Paint" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="8052-1c3d-be29-0cb3">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: a Deathskull unit is selected as the target of a Shooting Attack. Against that attack, the unit's models have Feel No Pain (5+), or improve an existing Feel No Pain by 1. A Deathskull vehicle instead improves its Ramshackle (X) by 1 against that attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Lucky Blue Gitz" id="5ec0-6806-405c-7591" hidden="false">
                  <description>Once per turn, a unit with this rule may re-roll one dice that rolled a 1.</description>
                </rule>
                <rule name="Mekboyz' Favourites" id="d730-4544-7c2b-0a30" hidden="false">
                  <description>models in the unit improve their Mek-Smasha (X) and Grot Riggers (X) by 1, to a best of 3+. This stacks with a grot oiler, so a Deathskull Mek with a grot oiler has Mek-Smasha (3+).</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Evil Sunz" hidden="false" id="25c2-c4fc-1bc1-6ac5" publicationId="96d0-c462-d158-fbad">
              <profiles>
                <profile name="Fasta Than Bullets" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="1a3b-90eb-4d1e-073d">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Shooting phase). Trigger: an Evil Sunz unit is selected as the target of a Shooting Attack. Before the attack is resolved, the unit moves up to D6 plus its Initiative Characteristic in inches (vehicles and Cavalry move up to 6" instead). If the unit is then out of range or line of sight, the attack is lost; otherwise it is resolved as normal.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Need for Speed" id="f04a-def9-287d-9880" hidden="false">
                  <description>the unit gains Fleet (1).</description>
                </rule>
                <rule name="Red Ones Go Fasta" id="fb10-0a5f-5b3e-0d2a" hidden="false">
                  <description>add 1 to the Movement Characteristic of Cavalry models and vehicles.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Goffs" hidden="false" id="22c6-363a-67fd-1836" publicationId="96d0-c462-d158-fbad">
              <profiles>
                <profile name="Headbutt 'Em First" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="7941-9176-826d-5731">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Goff unit. Instead of firing Overwatch, the Goff unit gains the Counter-Charge (2) and Reach (2) special rules until the end of the phase†. The charging unit keeps its bonuses for charging.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Kill 'Em All" id="22ce-f914-ab80-ff0a" hidden="false">
                  <description>in a turn in which the unit charged, it may re-roll to-hit rolls of 1 in close combat.</description>
                </rule>
                <rule name="Rage" id="3d81-b9c1-4083-8619" hidden="false">
                  <description>the unit has the Rage (2) special rule.</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Snakebites" hidden="false" id="7cb2-c4cf-dfb7-3b04" publicationId="96d0-c462-d158-fbad">
              <profiles>
                <profile name="Let Loose Da Squigs" typeId="90b9-7fab-87db-aed3" typeName="Reactions" hidden="false" id="d45a-df72-4be1-0113">
                  <characteristics>
                    <characteristic name="Description" typeId="c627-4637-8de5-65fb">(Assault phase). Trigger: an enemy unit declares a charge against a Snakebite unit. Instead of firing Overwatch, the Snakebites release a pack of squigs: the charging unit suffers D6 hits at Strength 4, AP – before it rolls its charge distance.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Beast Ridin'" id="f021-2cbc-f7d7-cbfa" hidden="false">
                  <description>Beast Snagga Boyz, Squighog Boyz and models on squigs or Squigosaurs gain the Line Unit Sub-type.</description>
                </rule>
                <rule name="Da Old Ways" id="9300-eb76-647f-5258" hidden="false">
                  <description>add 1 to the Leadership a unit uses for Mob Rule, to a maximum of 10.</description>
                </rule>
                <rule name="Mob Up" id="79c3-b29c-f7c5-970e" hidden="false">
                  <description>at the end of your Movement phase, two Gretchin units in a Snakebite detachment that are within 2" of each other may merge into a single unit, up to 30 Gretchin. Keep all Runtherds; the merged unit cannot split again. This applies even though Gretchin do not gain Klan (X).</description>
                </rule>
              </rules>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Rite of War" hidden="false" id="e7fa-8c3b-aa55-00b3">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e2a2-6241-0bef-2cef" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Dread Mob" hidden="false" id="29c4-3570-de92-29f9" publicationId="96d0-c462-d158-fbad">
              <rules>
                <rule name="Effects" id="ff59-8b49-e2fc-17b6" hidden="false">
                  <description>Killa Kans may be taken as Troops choices in a Detachment using this Rite of War. Every model with Mek-Smasha (X) in a Detachment using this Rite of War improves it by 1, to a best of Mek-Smasha (3+).</description>
                </rule>
                <rule name="Limitations" id="26d2-f8d2-c516-d9aa" hidden="false">
                  <description>A Detachment using this Rite of War must have a Big Mek as its Warlord. A Detachment using this Rite of War may not include more Infantry units than it has Dreadnought units. This Rite of War may not be used by an Allied Detachment.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="2cbb-e1e1-80a2-229a" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Green Tide" hidden="false" id="669a-ae9c-8123-7219" publicationId="96d0-c462-d158-fbad">
              <rules>
                <rule name="Effects" id="83e8-faf0-a3f8-6b3f" hidden="false">
                  <description>Boyz units in a Detachment using this Rite of War may contain up to 40 models, and Big Boyz units may contain up to 30 models. Units of 20 or more Boyz in a Detachment using this Rite of War use Leadership 10 for Mob Rule.</description>
                </rule>
                <rule name="Limitations" id="1e63-0b90-eb10-a4c4" hidden="false">
                  <description>A Detachment using this Rite of War must have a Warboss as its Warlord. A Detachment using this Rite of War may not include any Lords of War, or more than two Heavy Support choices. This Rite of War may not be used by an Allied Detachment.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="c10a-727f-5b11-be06" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Snagga Hunt" hidden="false" id="5150-f28c-375b-ad54" publicationId="96d0-c462-d158-fbad">
              <rules>
                <rule name="Effects" id="ce13-9242-3cf1-ad3b" hidden="false">
                  <description>Squighog Boyz may be taken as Troops choices in a Detachment using this Rite of War. Beast Snagga units in a Detachment using this Rite of War re-roll to-wound rolls of 1 against Vehicles, Dreadnoughts and Monstrous Creatures.</description>
                </rule>
                <rule name="Limitations" id="2934-6128-57a4-c42d" hidden="false">
                  <description>A Detachment using this Rite of War must have a Beastboss, Beastboss on Squigosaur or Mozrog Skragbad as its Warlord. A Detachment using this Rite of War may not include any Flyers, any Gretchin, or any Heavy Support vehicles other than Kill Rigs and Hunta Rigs. This Rite of War may not be used by an Allied Detachment.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="f0a1-2757-95d8-1017" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Speed Freeks" hidden="false" id="ccb3-b830-f9f4-48b5" publicationId="96d0-c462-d158-fbad">
              <rules>
                <rule name="Effects" id="783c-5937-d041-03a3" hidden="false">
                  <description>Warbikers may be taken as Troops choices in a Detachment using this Rite of War, and gain the Line sub-type. Nobz on Warbikes may be taken as Fast Attack choices in a Detachment using this Rite of War. Ork vehicles with the Fast sub-type and Mechanised Ork Cavalry (the Speed Freek buggies) in a Detachment using this Rite of War improve their Ramshackle (X) by 1, so Ramshackle (6+) becomes Ramshackle (5+).</description>
                </rule>
                <rule name="Limitations" id="ef5b-602e-c34e-38e8" hidden="false">
                  <description>A Detachment using this Rite of War must have a Warboss or Big Mek on Warbike as its Warlord. Every Infantry unit in a Detachment using this Rite of War must start the game embarked on a Trukk or Battlewagon, or have rokk-packs. This Rite of War may not be used by an Allied Detachment.</description>
                </rule>
              </rules>
              <categoryLinks>
                <categoryLink targetId="d494-e450-d4aa-579a" id="16b8-5fad-296f-7099" primary="true" name="Rite of War:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Warlord Trait" hidden="false" id="28b2-da56-af1f-f4c8">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="35d5-5bcb-4f64-5c6d" percentValue="false" includeChildSelections="false" includeChildForces="false" />
          </constraints>
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Bellowin' Tyrant" hidden="false" id="6a9a-a2f4-8407-2412" publicationId="96d0-c462-d158-fbad">
              <profiles>
                <profile name="Bellowin' Tyrant" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="a1eb-4716-4d85-eaab">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord and any unit he joins gain the Furious Charge (1) special rule, or increase an existing Furious Charge (X) by 1. In addition, once per game, a friendly Ork unit within 12" of the Warlord may make the Get Stuck In reaction without spending a point of the Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="a538-f325-83f9-3384" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Da Boss Is Watchin'" hidden="false" id="5c14-33ba-ebc4-f458" publicationId="96d0-c462-d158-fbad">
              <profiles>
                <profile name="Da Boss Is Watchin'" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="be7e-5b7c-7874-c556">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Friendly Ork units within 12" of the Warlord may use his Leadership for Morale checks and Pinning tests, and units within 6" of him may use Breakin' Heads without suffering any hits. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Movement phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="56c3-51af-074c-74c5" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Might Is Right" hidden="false" id="eab6-ba2c-5d93-3ddb" publicationId="96d0-c462-d158-fbad">
              <profiles>
                <profile name="Might Is Right" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="1f03-dd4a-3ff7-916d">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord adds 1 to his Strength and Attacks Characteristics in any turn in which he charged, or was charged. In addition, while the Warlord is on the battlefield, your army may make one additional reaction in your opponent's Assault phase, above its normal Reaction Allotment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="a972-7af2-1084-2ac3" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Da Biggest Gun" hidden="true" id="d70b-0e5f-a88a-f82b" publicationId="96d0-c462-d158-fbad">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="76f8-00ce-5d7b-d34a" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Da Biggest Gun" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="b304-9879-9961-0ded">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">Choose one ranged or melee weapon carried by the Warlord. That weapon gains the Master-crafted special rule.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="2edb-4e7e-3718-6ace" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Kunnin' Plan" hidden="true" id="2880-6e5c-dcb4-a763" publicationId="96d0-c462-d158-fbad">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="9641-5c76-afc1-1fa8" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Kunnin' Plan" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="e4cf-eb92-30f5-f73b">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">After both armies have deployed, but before the first turn, you may redeploy up to 3 friendly Blood Axe units, following the normal deployment rules.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="1158-146a-d9a0-39ad" id="00b3-c4f9-6f60-8200" primary="true" name="Warlord Traits:" />
              </categoryLinks>
              <costs>
                <cost name="Pts" typeId="d2ee-04cb-5f8a-2642" value="0" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Dead Lucky" hidden="true" id="b6e5-fe58-8073-5059" publicationId="96d0-c462-d158-fbad">
              <modifiers>
                <modifier type="set" field="hidden" value="false">
                  <conditions>
                    <condition type="atLeast" value="1" field="selections" scope="force" childId="8020-4d05-451b-101e" shared="true" includeChildSelections="true" includeChildForces="false" />
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Dead Lucky" typeId="a0e6-a7b4-d55d-85b8" typeName="Warlord Trait" hidden="false" id="f873-52f4-e01c-e0eb">
                  <characteristics>
                    <characteristic name="Text" typeId="c68e-2cda-b67b-baca">The Warlord has a 5+ Invulnerable Save. If he already has an Invulnerable Save, improve it by 1, to a best of 3+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
