      <rules>
        <rule name="Full Throttle" id="0e81-6b7b-017f-504b" hidden="false">
          <description>When the unit activates its rokk-packs, it may add its Initiative Characteristic to its move. If it does, all terrain counts as Dangerous Terrain for the unit until the end of the turn</description>
